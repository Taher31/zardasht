---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';
import { metaDescription } from '../../data/meta-descriptions';
import { localizedCountryName, normalizeCountryCode, countryFlagPath } from '../../data/country-locale';
import { getNewsPosts, formatNewsDate } from '../../data/news';
import { imageSize } from '../../data/image-size';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const categories = t.pages.home.categories.map((category) => ({
  ...category,
  href: withLanguagePrefix(lang, category.href),
}));
const productSections = t.pages.products.sections;

const tradeImages = {
  bitumen: '/images/02_bitumen.webp',
  steel: '/images/03_metals_steel.webp',
  agriculture: '/images/04_agricultural_grain.webp',
  textile: '/images/05_textile_yarn.webp',
  logistics: '/images/06_road_logistics_truck.webp',
  rail: '/images/07_rail_logistics.webp',
  warehouse: '/images/08_warehouse_logistics.webp',
} as const;

const categoryImages: Record<string, string> = {
  'energy-bitumen': tradeImages.bitumen,
  'metals-steel': tradeImages.steel,
  'agricultural-commodities': tradeImages.agriculture,
  'textile-raw-materials': tradeImages.textile,
  // Bagged goods on pallets — how polymer grades and dry chemicals actually ship.
  'chemicals-petrochemicals': tradeImages.warehouse,
};

const railLogisticsVideo = '/video/07_rail_logistics.mp4';

const categoryVideos: Record<string, string> = {
  'energy-bitumen': '/video/02_bitumen.mp4',
  'agricultural-commodities': '/video/04_agricultural_grain.mp4',
};

const categoriesWithSpecs = categories.map((category) => {
  // Each category now links to its own page (/products/<id>), so the id is
  // the last path segment rather than a fragment.
  const fragment = category.href.split('/').pop() ?? '';
  const productSection = productSections.find((section) => section.id === fragment);
  return {
    ...category,
    image: categoryImages[fragment] ?? tradeImages.logistics,
    video: categoryVideos[fragment],
    specLine: productSection?.products?.[0]?.description ?? '',
  };
});

const faq = t.pages.home.faq;
const logisticsCards = t.pages.solutions.solutions;
// Heroicons outline paths, drawn at 24x24 — index-aligned with logisticsCards
// (sourcing, inspection, freight, customs, delivery, payment).
const solutionIcons = [
  'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4',
  'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8 0h2m-2 0V8a1 1 0 011-1h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01.052.316V16a1 1 0 01-1 1h-1',
  'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
  'M17.657 16.657L13.414 20.9a2 2 0 01-2.828 0l-4.243-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z',
  'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
];
// One panel per commodity group; the portrait photos suit vertical panels.
// Only 4 show at once, but the rotation script cycles through every group —
// heroQueue is the full list (serialized below) it pulls the next one from.
const heroPanels = categoriesWithSpecs.slice(0, 4);
// The panel images are also carried with their intrinsic size: the rotation
// script builds <img> elements at runtime, and without width/height those
// would be the only images on the page that can still shift the layout.
const heroQueue = categoriesWithSpecs.map(({ href, name, badge, image, video }) => ({
  href,
  name,
  badge,
  image,
  video,
  ...imageSize(image),
}));

// Controls for the commodity-group slider (not covered by the shared i18n labels).
const sliderChrome = {
  en: { region: 'Commodity groups', prev: 'Previous commodity groups', next: 'Next commodity groups' },
  fa: { region: 'گروه‌های کالایی', prev: 'گروه‌های کالایی قبلی', next: 'گروه‌های کالایی بعدی' },
  ar: { region: 'مجموعات السلع', prev: 'مجموعات السلع السابقة', next: 'مجموعات السلع التالية' },
  ru: { region: 'Товарные группы', prev: 'Предыдущие товарные группы', next: 'Следующие товарные группы' },
} as const;
const sliderLabels = sliderChrome[lang] ?? sliderChrome.en;
// Real import/export lanes, shown as a rail under the headline.
const heroLanes = t.pages.home.industries.slice(0, 4);

// Counter figures are derived from real data wherever possible, so adding a
// country to trade-countries.json (or a product group) updates the homepage
// automatically instead of silently going stale. Only "years" is a literal.
const tradeCountriesPath = path.join(process.cwd(), 'public', 'data', 'trade-countries.json');
const activeCountries = JSON.parse(fs.readFileSync(tradeCountriesPath, 'utf-8')).filter(
  (country: { status: boolean }) => country.status,
);
const activeMarketCount = activeCountries.length;

// Flags orbit the ring; each one is evenly spaced and links to its market page.
const marketFlags = activeCountries.map(
  (country: { country_code: string; country_name: string }, index: number) => {
    const code = normalizeCountryCode(country.country_code);
    return {
      code,
      name: localizedCountryName(lang, code, country.country_name),
      href: withLanguagePrefix(lang, `/trade-map/${code.toLowerCase()}`),
      flag: countryFlagPath(code),
      angle: (360 / activeMarketCount) * index,
    };
  },
);

// Featured posts lead the homepage strip; if fewer than three are flagged,
// the newest remaining posts fill the row so it never renders half-empty.
const allNews = getNewsPosts(lang);
const homeNews = [
  ...allNews.filter((post) => post.featured),
  ...allNews.filter((post) => !post.featured),
]
  .slice(0, 3)
  .map((post) => ({
    ...post,
    href: withLanguagePrefix(lang, `/news/${post.slug}`),
    displayDate: formatNewsDate(post.date, lang),
  }));

const derivedCounterValues: Record<string, number> = {
  groups: t.pages.products.sections.length,
  lanes: t.pages.home.industries.length,
  markets: activeMarketCount,
};

// Render the final figure server-side (correct digits per locale, and it stays
// readable without JS); the client only animates from zero up to it.
const counterFormatter = new Intl.NumberFormat(lang);
const counters = t.pages.home.counters.map((counter) => {
  const value = derivedCounterValues[counter.key] ?? counter.value;
  return { ...counter, value, display: counterFormatter.format(value) };
});

// The FAQ block further down is real on-page content, so it can be declared
// as FAQPage and become eligible for the expandable result in search.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: lang,
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<Layout
  title={t.pages.home.title}
  lang={lang}
  translation={t}
  description={metaDescription(lang, 'home') ?? t.pages.home.heroSubtitle}
  schema={[faqSchema]}
>

  <section class="trade-hero" data-trade-hero data-hero-queue={JSON.stringify(heroQueue)} aria-label={t.pages.home.title}>
    <div class="trade-hero__panels">
      {heroPanels.map((panel, index) => (
        <a
          href={panel.href}
          class:list={['trade-hero__panel', index === 0 && 'is-active']}
          data-hero-panel={index}
          aria-label={panel.name}
        >
          <span class="trade-hero__panel-media">
            {panel.video ? (
              <video
                poster={panel.image}
                muted
                loop
                playsinline
                preload="none"
                aria-hidden="true"
                data-fallback-video
                data-fallback={tradeImages.logistics}
                data-fallback-width={imageSize(tradeImages.logistics).width}
                data-fallback-height={imageSize(tradeImages.logistics).height}
                data-video-src={panel.video}
              ></video>
            ) : (
              <img
                src={panel.image}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                data-fallback-image
                data-fallback={tradeImages.logistics}
                {...imageSize(panel.image)}
              />
            )}
          </span>
          <span class="trade-hero__panel-badge">{panel.badge}</span>
          <span class="trade-hero__panel-name">{panel.name}</span>
        </a>
      ))}
    </div>

    <div class="trade-hero__scrim" aria-hidden="true"></div>

    <svg class="trade-hero__arcs" viewBox="0 0 1200 800" preserveAspectRatio="none" aria-hidden="true">
      <path d="M120 470 C 400 250, 780 250, 1120 400" />
      <path d="M150 560 C 480 420, 820 460, 1150 300" />
      <path d="M100 380 C 380 480, 760 560, 1100 520" />
      <circle cx="120" cy="470" r="4" />
      <circle cx="150" cy="560" r="4" />
      <circle cx="100" cy="380" r="4" />
    </svg>

    <div class="trade-hero__grain" aria-hidden="true"></div>

    <div class="trade-hero__inner">
      <div class="trade-hero__brand">
        <span class="trade-hero__brand-mark">ZM</span>
        <span>{t.labels.brand}</span>
      </div>

      <div>
        <p class="trade-hero__kicker">{t.pages.home.eyebrow}</p>
        <h1>{t.pages.home.heroTitle}</h1>
        <p class="trade-hero__description">{t.pages.home.heroSubtitle}</p>

        <div class="trade-hero__actions">
          <a class="trade-button trade-button--primary" href={withLanguagePrefix(lang, '/contact')}>
            {t.pages.home.ctaPrimary}
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M5 3h8v8" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" /></svg>
          </a>
          <a class="trade-button trade-button--text" href={withLanguagePrefix(lang, '/products')}>
            {t.pages.home.ctaSecondary}
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter" /></svg>
          </a>
        </div>
      </div>

      <div class="trade-hero__lanes">
        {heroLanes.map((lane) => (
          <a class="trade-hero__lane" href={withLanguagePrefix(lang, '/trade-map')}>
            <span class="trade-hero__lane-dot" aria-hidden="true"></span>
            {lane.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1400px] px-4 py-12 sm:px-6 sm:py-16">
    <div class="mx-auto mb-10 max-w-3xl text-center">
      <p class="section-eyebrow">{t.pages.home.eyebrow}</p>
      <h2 class="section-title">{t.pages.home.categoriesTitle}</h2>
      <span class="section-accent" aria-hidden="true"></span>
      <p class="mt-5 text-base text-slate-600 sm:text-lg">
        {t.pages.home.categoriesIntro}
      </p>
    </div>

    <!-- Auto-scrolling, seamlessly-looping strip. Each group below renders the
         same cards; the animation slides the track exactly one group's width
         and then restarts, so the repeat is invisible. The second group is
         `inert` + aria-hidden so screen readers and Tab only ever reach the
         real set. Hover/focus pauses the motion (see the style block) so a
         card can be read or clicked without drifting away underneath.
         The prev/next arrows live in `.cat-marquee`'s own side padding, one
         level above the `overflow: hidden` on `.cat-marquee__viewport` — so
         they sit fully outside the card strip instead of being clipped by it. -->
    <div class="cat-marquee" data-cat-marquee>
      <div class="cat-marquee__viewport">
      <div class="cat-marquee__track" data-cat-track role="group" aria-label={sliderLabels.region}>
        <div class="cat-marquee__group" data-cat-group>
          {categoriesWithSpecs.map((category) => (
            <article class="cat-slide card group overflow-hidden transition hover:-translate-y-1 hover:shadow-2xl">
              <a href={category.href} class="relative block aspect-[4/3] overflow-hidden bg-[#19266A]">
                {category.video ? (
                  <video
                    poster={category.image}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-hidden="true"
                    data-fallback-video
                    data-fallback={tradeImages.logistics}
                    data-fallback-width={imageSize(tradeImages.logistics).width}
                    data-fallback-height={imageSize(tradeImages.logistics).height}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                    data-video-src={category.video}
                  ></video>
                ) : (
                  <img
                    src={category.image}
                    alt={category.name}
                    loading="lazy"
                    data-fallback-image
                    data-fallback={tradeImages.logistics}
                    class="h-full w-full object-cover transition duration-700 group-hover:scale-105"
                    {...imageSize(category.image)}
                  />
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-[#10184A]/85 via-[#10184A]/15 to-transparent"></div>
                <span class="absolute start-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 bg-[#10184A]/55 text-xs font-bold text-white backdrop-blur">
                  {category.badge}
                </span>
                <h3 class="absolute inset-x-4 bottom-4 text-xl font-semibold text-white">{category.name}</h3>
              </a>

              <div class="flex min-h-[220px] flex-col justify-between gap-5 p-5">
                <div class="space-y-3">
                  <p class="text-sm leading-7 text-slate-600">{category.description}</p>
                  {category.specLine && (
                    <p class="border-s-2 border-[#F3C623] ps-3 text-xs font-semibold leading-6 text-[#19266A]/75">{category.specLine}</p>
                  )}
                </div>
                <a class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A] transition group-hover:gap-3" href={category.href}>
                  {t.pages.home.ctaSecondary}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          ))}
        </div>

        <div class="cat-marquee__group" aria-hidden="true" inert>
          {categoriesWithSpecs.map((category) => (
            <article class="cat-slide card overflow-hidden">
              <!-- This whole group is aria-hidden + inert — it exists only so
                   the wrap-around looks seamless, nobody ever actually views
                   it playing. A real <video> here would autoplay and download
                   several more megabytes for something no one sees, so the
                   poster frame stands in for it instead. -->
              <div class="relative block aspect-[4/3] overflow-hidden bg-[#19266A]">
                <img src={category.image} alt="" {...imageSize(category.image)} loading="lazy" class="h-full w-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#10184A]/85 via-[#10184A]/15 to-transparent"></div>
                <span class="absolute start-4 top-4 inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/25 bg-[#10184A]/55 text-xs font-bold text-white backdrop-blur">
                  {category.badge}
                </span>
                <h3 class="absolute inset-x-4 bottom-4 text-xl font-semibold text-white">{category.name}</h3>
              </div>

              <div class="flex min-h-[220px] flex-col justify-between gap-5 p-5">
                <div class="space-y-3">
                  <p class="text-sm leading-7 text-slate-600">{category.description}</p>
                  {category.specLine && (
                    <p class="border-s-2 border-[#F3C623] ps-3 text-xs font-semibold leading-6 text-[#19266A]/75">{category.specLine}</p>
                  )}
                </div>
                <span class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A]">
                  {t.pages.home.ctaSecondary}
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </article>
          ))}
        </div>
      </div>
      </div>

      <button class="cat-marquee__arrow cat-marquee__arrow--prev" type="button" data-cat-prev aria-label={sliderLabels.prev}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 5 8 12 15 19"></polyline>
        </svg>
      </button>
      <button class="cat-marquee__arrow cat-marquee__arrow--next" type="button" data-cat-next aria-label={sliderLabels.next}>
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="9 5 16 12 9 19"></polyline>
        </svg>
      </button>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
    <div class="rounded-3xl bg-[#10184A] px-6 py-10 text-white shadow-2xl shadow-[#10184A]/40 sm:px-10">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-[#F3C623]">{t.pages.home.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.pages.home.countersTitle}</h2>
        <p class="mt-4 text-base leading-8 text-white/70">{t.pages.home.countersIntro}</p>
      </div>

      <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-4">
        {counters.map((counter) => (
          <div class="border-t border-white/15 pt-5">
            <dt class="sr-only">{counter.label}</dt>
            <dd>
              <p class="flex items-baseline gap-0.5 text-4xl font-extrabold tracking-tight text-white sm:text-5xl">
                <span data-counter={counter.value}>{counter.display}</span>
                {counter.suffix && <span class="text-[#F3C623]">{counter.suffix}</span>}
              </p>
              <p class="mt-3 text-sm font-semibold leading-6 text-white/65">{counter.label}</p>
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <p class="section-eyebrow">{t.pages.resources.eyebrow}</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[#19266A] sm:text-4xl">
          {t.pages.home.marketsTitle}
        </h2>
        <span class="mt-4 block h-[3px] w-16 rounded-full bg-[#F3C623]" aria-hidden="true"></span>
        <p class="mt-5 text-base leading-8 text-slate-600 sm:text-lg">{t.pages.home.marketsIntro}</p>

        <ul class="mt-7 flex flex-wrap gap-2">
          {marketFlags.map((market) => (
            <li>
              <a
                href={market.href}
                class="flag-chip"
                data-orbit-link={market.code}
              >
                <img src={market.flag} alt="" loading="lazy" {...imageSize(market.flag)} />
                {market.name}
              </a>
            </li>
          ))}
        </ul>

        <a
          class="pill-link mt-7 inline-flex bg-[#F3C623] text-[#10184A] shadow-lg shadow-[#F3C623]/25 transition hover:-translate-y-0.5"
          href={withLanguagePrefix(lang, '/trade-map')}
        >
          {t.labels.nav.tradeMap}
        </a>
      </div>

      <div class="flag-orbit" data-flag-orbit>
        <div class="flag-orbit__path" aria-hidden="true"></div>

        <div class="flag-orbit__ring">
          {marketFlags.map((market) => (
            <a
              class="flag-orbit__item"
              style={`--angle:${market.angle}deg`}
              href={market.href}
              aria-label={market.name}
              data-orbit-item={market.code}
            >
              <span class="flag-orbit__spin">
                <span class="flag-orbit__frame">
                  {/* Sits behind the flag, so a missing flag file degrades to
                      the country code instead of a blank tile. */}
                  <span class="flag-orbit__code" aria-hidden="true">{market.code}</span>
                  <img
                    class="flag-orbit__flag"
                    src={market.flag}
                    alt=""
                    loading="lazy"
                    {...imageSize(market.flag)}
                  />
                </span>
                <span class="flag-orbit__label">{market.name}</span>
              </span>
            </a>
          ))}
        </div>

        <div class="flag-orbit__core">
          <img src="/images/iran-flag.webp" alt="" class="flag-orbit__core-flag" width="297" height="170" loading="lazy" />
          <span class="flag-orbit__core-text">{t.pages.home.marketsHomeLabel}</span>
        </div>
      </div>
    </div>
  </section>

  {homeNews.length > 0 && (
    <section>
      <div class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="section-eyebrow">{t.pages.news.eyebrow}</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight text-[#19266A] sm:text-4xl">
              {t.pages.news.homeTitle}
            </h2>
            <p class="mt-4 max-w-xl text-base leading-8 text-slate-600">{t.pages.news.homeIntro}</p>
          </div>
          <a
            class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A] transition hover:gap-3"
            href={withLanguagePrefix(lang, '/news')}
          >
            {t.pages.news.allNews}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
          {homeNews.map((post) => (
            <a href={post.href} class="card group flex flex-col overflow-hidden">
              <div class="relative h-44 overflow-hidden bg-[#19266A]">
                <img
                  src={post.image}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                  {...imageSize(post.image)}
                />
              </div>
              <div class="flex flex-1 flex-col gap-3 p-5">
                <time datetime={post.date} class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#19266A]/50">
                  {post.displayDate}
                </time>
                <h3 class="text-lg font-semibold leading-snug text-[#19266A]">{post.title}</h3>
                <p class="text-sm leading-6 text-slate-600">{post.excerpt}</p>
                <span class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-bold text-[#19266A] transition group-hover:gap-3">
                  {t.pages.news.readMore}
                  <span aria-hidden="true">→</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
