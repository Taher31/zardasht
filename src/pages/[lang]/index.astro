  <script>
    const heroEl = document.querySelector('[data-trade-hero]');

    if (heroEl) {
      const panelContainer = heroEl.querySelector('.trade-hero__panels');
      const panels = Array.from(heroEl.querySelectorAll('[data-hero-panel]'));
      const initialActiveIndex = panels.findIndex((panel) => panel.classList.contains('is-active'));
      let activeIndex = initialActiveIndex >= 0 ? initialActiveIndex : 0;
      let timer = 0;

      // The DOM only ever holds `panels.length` (4) slots — only that many
      // commodity groups are ever visible at once — but there can be more
      // groups than that. `queue` holds all of them; each rotation swaps the
      // slot leaving the front for the next group in the queue before
      // sending it to the back, so every group eventually cycles through.
      const reduceHeroMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      // The panels this script builds are the one place video is attached
      // without going through the deferred loader in Layout.astro, so the same
      // affordability test is applied here: a phone, a metered connection or a
      // reduce-motion preference gets the still frame and downloads no video.
      const heroVideoAllowed =
        !reduceHeroMotion && navigator.connection?.saveData !== true && window.innerWidth >= 1024;
      let queue = [];
      try {
        queue = JSON.parse(heroEl.dataset.heroQueue || '[]');
      } catch {
        queue = [];
      }
      let queueIndex = panels.length;

      const applyPanelContent = (panel, data) => {
        if (!data) return;
        panel.href = data.href;
        panel.setAttribute('aria-label', data.name);

        const badgeEl = panel.querySelector('.trade-hero__panel-badge');
        if (badgeEl) badgeEl.textContent = data.badge;

        const nameEl = panel.querySelector('.trade-hero__panel-name');
        if (nameEl) nameEl.textContent = data.name;

        const mediaEl = panel.querySelector('.trade-hero__panel-media');
        if (!mediaEl) return;
        mediaEl.textContent = '';

        if (data.video && heroVideoAllowed) {
          const video = document.createElement('video');
          video.poster = data.image;
          video.autoplay = true;
          video.muted = true;
          video.loop = true;
          video.playsInline = true;
          video.preload = 'none';
          video.setAttribute('aria-hidden', 'true');
          const source = document.createElement('source');
          source.src = data.video;
          source.type = 'video/mp4';
          video.appendChild(source);
          // Same degrade-to-image-on-error behaviour as the server-rendered panels.
          video.addEventListener('error', () => {
            const image = document.createElement('img');
            image.src = data.image;
            image.alt = '';
            image.loading = 'lazy';
            if (data.width) image.width = data.width;
            if (data.height) image.height = data.height;
            video.replaceWith(image);
          }, { once: true });
          mediaEl.appendChild(video);
        } else {
          const image = document.createElement('img');
          image.src = data.image;
          image.alt = '';
          image.loading = 'lazy';
          if (data.width) image.width = data.width;
          if (data.height) image.height = data.height;
          mediaEl.appendChild(image);
        }
      };

      const setPanel = (nextIndex) => {
        activeIndex = (nextIndex + panels.length) % panels.length;
        panels.forEach((panel, index) => panel.classList.toggle('is-active', index === activeIndex));
      };

      const stop = () => {
        if (!timer) return;
        window.clearInterval(timer);
        timer = 0;
      };

      const rotatePanels = () => {
        if (!panelContainer || panels.length < 2) return;
        const firstPanel = panels.shift();
        if (!firstPanel) return;

        if (queue.length > panels.length + 1) {
          applyPanelContent(firstPanel, queue[queueIndex % queue.length]);
          queueIndex++;
        }

        panels.push(firstPanel);
        panelContainer.append(firstPanel);
        setPanel(0);
      };

      const start = () => {
        stop();
        if (panels.length < 2) return;
        timer = window.setInterval(rotatePanels, 4200);
      };

      panels.forEach((panel) => {
        const activatePanel = () => {
          stop();
          setPanel(panels.indexOf(panel));
        };

        panel.addEventListener('mouseenter', activatePanel);
        panel.addEventListener('focus', activatePanel);
        panel.addEventListener('mouseleave', start);
        panel.addEventListener('blur', start);
      });

      if (panels.length) {
        setPanel(activeIndex);
        start();
      }

    }

    // Every autoplaying video on the page, not just the hero's.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    document.querySelectorAll('[data-fallback-video]').forEach((video) => {
      if (!(video instanceof HTMLVideoElement)) return;
      if (reduceMotion) {
        video.pause();
        video.removeAttribute('autoplay');
        return;
      }
      // A failed source (unsupported codec, bad path) should degrade to the
      // still image rather than leaving a blank/broken video box.
      video.addEventListener('error', () => {
        const fallback = video.dataset.fallback;
        if (!fallback) return;
        const image = document.createElement('img');
        image.src = fallback;
        image.alt = '';
        image.loading = 'lazy';
        image.className = video.className;
        // Sizes travel on the element so the swapped-in still reserves the
        // same box the video occupied.
        if (video.dataset.fallbackWidth) image.width = Number(video.dataset.fallbackWidth);
        if (video.dataset.fallbackHeight) image.height = Number(video.dataset.fallbackHeight);
        video.replaceWith(image);
      }, { once: true });
    });
  </script>

  <script>
    const counterEls = Array.from(document.querySelectorAll('[data-counter]'));

    if (counterEls.length) {
      const formatter = new Intl.NumberFormat(document.documentElement.lang || 'en');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const countUp = (el) => {
        const target = Number(el.getAttribute('data-counter')) || 0;
        // Respecting reduced motion means showing the final value immediately.
        if (reduceMotion) {
          el.textContent = formatter.format(target);
          return;
        }
        const duration = 1400;
        const startedAt = performance.now();
        const step = (now) => {
          const progress = Math.min((now - startedAt) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = formatter.format(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            countUp(entry.target);
            observer.unobserve(entry.target);
          });
        }, { threshold: 0.4 });
        counterEls.forEach((el) => observer.observe(el));
      } else {
        // Without IntersectionObserver the server-rendered value already stands.
        counterEls.forEach(countUp);
      }
    }
  </script>

  <script>
    // Hovering a flag chip highlights the matching flag out on the ring, so the
    // two lists read as one control rather than two separate ones.
    const orbit = document.querySelector('[data-flag-orbit]');

    if (orbit) {
      const itemFor = (code) => orbit.querySelector(`[data-orbit-item="${code}"]`);

      document.querySelectorAll('[data-orbit-link]').forEach((chip) => {
        const code = chip.getAttribute('data-orbit-link');
        const highlight = (on) => itemFor(code)?.classList.toggle('is-highlighted', on);

        chip.addEventListener('mouseenter', () => highlight(true));
        chip.addEventListener('mouseleave', () => highlight(false));
        chip.addEventListener('focus', () => highlight(true));
        chip.addEventListener('blur', () => highlight(false));
      });
    }
  </script>

  <script>
    document.querySelectorAll('[data-fallback-image]').forEach((image) => {
      if (!(image instanceof HTMLImageElement)) return;
      image.addEventListener('error', () => {
        const fallback = image.dataset.fallback;
        if (!fallback || image.src.endsWith(fallback)) return;
        image.src = fallback;
      }, { once: true });
    });
  </script>

  <script>
    // Commodity-group carousel. The track holds the real card group plus an
    // identical, inert duplicate; every few seconds (and on every prev/next
    // click) the track animates exactly one card's width, then pauses — a
    // discrete step rather than a continuously drifting ribbon. The offset
    // wraps at one group's width, and because the duplicate is
    // pixel-identical to the original the wrap is invisible, so the strip
    // still reads as infinite.
    const marquee = document.querySelector('[data-cat-marquee]');

    if (marquee instanceof HTMLElement) {
      const viewportEl = marquee.querySelector('.cat-marquee__viewport');
      const track = marquee.querySelector('[data-cat-track]');
      const group = marquee.querySelector('[data-cat-group]');
      const prevButton = marquee.querySelector('[data-cat-prev]');
      const nextButton = marquee.querySelector('[data-cat-next]');

      if (viewportEl instanceof HTMLElement && track instanceof HTMLElement && group instanceof HTMLElement) {
        const isRtl = document.documentElement.dir === 'rtl';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const stepDuration = 650; // ms per shift
        const stepEasing = 'cubic-bezier(0.65, 0, 0.35, 1)';
        const autoAdvanceDelay = 3200; // ms of rest between automatic shifts
        const pauseAfterInteraction = 4200; // ms the auto-advance stays paused after a manual click

        let offset = 0;
        let groupWidth = 0;
        let viewportWidth = 0;
        let hovering = false;
        let resumeAt = 0;
        let timer = 0;

        // The DOM only holds two groups (2 * groupWidth of real content), so
        // offset must never leave the strip showing past the end of that —
        // i.e. offset + viewportWidth must stay <= 2 * groupWidth.
        const measure = () => {
          groupWidth = group.getBoundingClientRect().width;
          viewportWidth = viewportEl.getBoundingClientRect().width;
        };

        const slideStep = () => {
          const first = group.querySelector('.cat-slide');
          if (!(first instanceof HTMLElement)) return groupWidth || 1;
          const trackGap = parseFloat(getComputedStyle(group).columnGap || '0') || 0;
          return first.getBoundingClientRect().width + trackGap;
        };

        const render = (animate) => {
          track.style.transition = animate && !reduceMotion ? `transform ${stepDuration}ms ${stepEasing}` : 'none';
          const sign = isRtl ? 1 : -1;
          track.style.transform = `translateX(${sign * offset}px)`;
        };

        // Instantly (no transition) re-anchor to the visually-identical spot
        // one group over, so the next animated step always has real DOM
        // content to move into — the duplicate group makes the two spots
        // pixel-identical, so the jump is invisible.
        const snapTo = (nextOffset) => {
          offset = nextOffset;
          render(false);
          void track.offsetWidth; // flush, so the next render() re-enables the transition cleanly
        };

        // A resize (or a browser zoom change, which is a resize too) can
        // change groupWidth/viewportWidth out from under a stale offset —
        // e.g. crossing the breakpoint where the card size changes — so the
        // safe range has to be re-enforced independently of shift(), not
        // just inside it.
        const normalizeOffset = () => {
          if (groupWidth <= 0) return;
          let guard = 0;
          while (offset < 0 && guard++ < 20) offset += groupWidth;
          while (offset + viewportWidth > groupWidth * 2 && guard++ < 20) offset -= groupWidth;
        };

        const shift = (direction, animate = true) => {
          if (groupWidth <= 0) return;
          const step = slideStep();
          if (direction < 0 && offset - step < 0) snapTo(offset + groupWidth);
          else if (direction > 0 && offset + step + viewportWidth > groupWidth * 2) snapTo(offset - groupWidth);
          offset += direction * step;
          render(animate);
        };

        const scheduleNext = () => {
          window.clearTimeout(timer);
          timer = window.setTimeout(autoAdvance, autoAdvanceDelay);
        };

        const autoAdvance = () => {
          if (!reduceMotion && !hovering && performance.now() >= resumeAt) shift(1);
          scheduleNext();
        };

        const nudge = (direction) => {
          shift(direction);
          resumeAt = performance.now() + pauseAfterInteraction;
        };

        prevButton?.addEventListener('click', () => nudge(-1));
        nextButton?.addEventListener('click', () => nudge(1));

        // Only a real cursor should pause on hover. On touch, `pointerenter`
        // fires on tap and its matching `pointerleave` is not guaranteed,
        // which would leave the strip paused for good.
        marquee.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') hovering = true;
        });
        marquee.addEventListener('pointerleave', (event) => {
          if (event.pointerType === 'mouse') hovering = false;
        });
        marquee.addEventListener('focusin', () => { hovering = true; });
        marquee.addEventListener('focusout', () => { hovering = false; });

        // Drag/swipe. The arrows are hidden on phones, so this is the only
        // way to move the strip by hand there. `touch-action: pan-y` on the
        // viewport (see the style block) keeps vertical page scrolling with
        // the browser and gives us the horizontal axis.
        let dragging = false;
        let dragPointerId = null;
        let dragStartX = 0;
        let dragStartOffset = 0;
        let dragMoved = 0;
        // Dragging toward the page's "next" side must increase offset, which
        // is the opposite screen direction in RTL.
        const dragSign = isRtl ? -1 : 1;

        viewportEl.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'mouse' && event.button !== 0) return;
          dragging = true;
          dragPointerId = event.pointerId;
          dragStartX = event.clientX;
          dragStartOffset = offset;
          dragMoved = 0;
          resumeAt = performance.now() + pauseAfterInteraction;
        });

        viewportEl.addEventListener('pointermove', (event) => {
          if (!dragging || event.pointerId !== dragPointerId) return;
          const delta = (dragStartX - event.clientX) * dragSign;
          dragMoved = Math.abs(event.clientX - dragStartX);
          // Only claim the gesture once it is clearly horizontal, so a
          // vertical flick still scrolls the page.
          if (dragMoved < 6) return;
          if (viewportEl.hasPointerCapture?.(event.pointerId) === false) {
            viewportEl.setPointerCapture(event.pointerId);
          }
          offset = dragStartOffset + delta;
          // Wrap mid-gesture, not just on release: a finger can drag the
          // strip straight past either end, and without this it exposes the
          // blank area beyond the two rendered groups while still held.
          // dragStartOffset moves by the same amount so the delta the rest
          // of the gesture is measured against — and the snap on release —
          // stay correct across the wrap.
          if (groupWidth > 0) {
            let guard = 0;
            while (offset < 0 && guard++ < 20) {
              offset += groupWidth;
              dragStartOffset += groupWidth;
            }
            while (offset + viewportWidth > groupWidth * 2 && guard++ < 20) {
              offset -= groupWidth;
              dragStartOffset -= groupWidth;
            }
          }
          render(false);
        });

        const endDrag = (event) => {
          if (!dragging || (event && event.pointerId !== dragPointerId)) return;
          dragging = false;
          dragPointerId = null;
          const step = slideStep();
          if (step > 0) {
            // Settle on the nearest whole card rather than wherever the
            // finger happened to lift.
            const settled = Math.round((offset - dragStartOffset) / step) * step;
            offset = dragStartOffset + settled;
          }
          normalizeOffset();
          render(true);
          resumeAt = performance.now() + pauseAfterInteraction;
        };

        viewportEl.addEventListener('pointerup', endDrag);
        viewportEl.addEventListener('pointercancel', endDrag);

        // A drag that moved the strip shouldn't also open the card it ended on.
        viewportEl.addEventListener('click', (event) => {
          if (dragMoved > 8) {
            event.preventDefault();
            event.stopPropagation();
          }
          dragMoved = 0;
        }, true);

        measure();
        normalizeOffset();
        render(false);
        scheduleNext();

        let resizeTimer = 0;
        const remeasure = () => {
          window.clearTimeout(resizeTimer);
          resizeTimer = window.setTimeout(() => {
            measure();
            normalizeOffset();
            render(false);
          }, 120);
        };

        if ('ResizeObserver' in window) {
          new ResizeObserver(remeasure).observe(group);
        } else {
          window.addEventListener('resize', remeasure);
        }
      }
    }
  </script>

  <style>
    /* Stepped auto-advancing loop: the track holds two identical groups side
       by side. A script (see above) animates translateX by exactly one
       card's width at a time — on a timer, or on a prev/next click — and
       wraps at one group's width; because the duplicate group is
       pixel-identical to the first, the wrap is invisible and the strip
       reads as infinite. */
    /* On phones the strip runs edge to edge and is driven by swiping, so it
       gets no side gutters — reserving 2 * 2.75rem out of a ~343px content
       box left too little room for a card and clipped it. The arrow gutters
       only appear from 640px up, where there is width to spare for them. */
    .cat-marquee {
      position: relative;
      padding-inline: 0;
    }

    @media (min-width: 640px) {
      .cat-marquee {
        /* Room for the prev/next arrows, which live here (outside the
           viewport's overflow: hidden) so they sit clear of the cards
           instead of being clipped by the strip. */
        padding-inline: 2.75rem;
      }
    }

    /* At the breakpoint where the design targets exactly four visible
       cards, cap the width to fit four cards + gaps + the two arrow
       gutters exactly — so no sliver of a fifth card ever peeks in. */
    @media (min-width: 1024px) {
      .cat-marquee {
        max-width: calc(4 * 280px + 3 * 1.5rem + 2 * 2.75rem);
        margin-inline: auto;
      }
    }

    .cat-marquee__viewport {
      overflow: hidden;
      padding-block: 0.75rem 1.25rem;
      /* Vertical flicks stay with the browser's page scroll; the horizontal
         axis is handled by the drag script above. */
      touch-action: pan-y;
    }

    .cat-marquee__track {
      display: flex;
      width: max-content;
      will-change: transform;
    }

    .cat-marquee__group {
      display: flex;
      flex-shrink: 0;
      gap: 1.5rem;
      padding-inline-end: 1.5rem;
    }

    /* One card plus a sliver of the next, so it reads as swipeable. The
       section's own px-4 takes 2rem, and the leftover 3.5rem leaves that
       peek — measured against the viewport rather than a percentage, since
       the track is `width: max-content` and would resolve a % against
       itself. */
    .cat-slide {
      width: calc(100vw - 5.5rem);
      max-width: 320px;
      flex-shrink: 0;
    }

    @media (min-width: 640px) {
      .cat-slide {
        width: 300px;
      }
    }

    @media (min-width: 1024px) {
      .cat-slide {
        width: 280px;
      }
    }

    /* Hidden on phones, where the strip is swiped instead — there is no
       gutter to put them in, and overlaying them would cover the card. */
    .cat-marquee__arrow {
      position: absolute;
      top: 50%;
      z-index: 2;
      display: none;
      height: 2.75rem;
      width: 2.75rem;
      align-items: center;
      justify-content: center;
      border-radius: 9999px;
      border: 1px solid rgba(25, 38, 106, 0.12);
      background: #ffffff;
      color: #19266a;
      box-shadow: 0 10px 30px rgba(16, 24, 74, 0.18);
      transform: translateY(-50%);
      transition: transform 0.2s ease;
    }

    @media (min-width: 640px) {
      .cat-marquee__arrow {
        display: inline-flex;
      }
    }

    .cat-marquee__arrow:hover {
      transform: translateY(-50%) scale(1.06);
    }

    .cat-marquee__arrow--prev {
      inset-inline-start: 0;
    }

    .cat-marquee__arrow--next {
      inset-inline-end: 0;
    }

    /* The chevrons are drawn pointing left/right; mirror them for RTL. */
    :global([dir='rtl']) .cat-marquee__arrow svg {
      transform: scaleX(-1);
    }

    @media (prefers-reduced-motion: reduce) {
      .cat-marquee__arrow {
        transition: none;
      }
    }
  </style>

</Layout>
