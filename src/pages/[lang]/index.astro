---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const categories = t.pages.home.categories.map((category) => ({
  ...category,
  href: withLanguagePrefix(lang, category.href),
}));
const productSections = t.pages.products.sections;
const categoriesWithSpecs = categories.map((category) => {
  const fragment = category.href.split('#')[1];
  const productSection = productSections.find((section) => section.id === fragment);
  return {
    ...category,
    specLine: productSection?.products?.[0]?.description ?? '',
  };
});
const industries = t.pages.home.industries;
const faq = t.pages.home.faq;
const trustBadges = t.pages.home.trustBadges;
const trustBadgeChips = trustBadges.slice(0, 2);
const complianceCards = t.pages.resources.cards;
const logisticsCards = t.pages.solutions.solutions;
const exportSteps = t.pages.solutions.outcomes;
const galleryImages = [
  '/images/pulses-1.png',
  '/images/pulses-2.png',
  '/images/pulses-3.png',
  '/images/pulses-4.png',
  '/images/pulses-5.png',
  '/images/pulses-6.png',
  '/images/pulses-7.png',
  '/images/pulses-8.png',
  '/images/pulses-9.png',
  '/images/pulses-10.png',
  '/images/logestic1.jpg',
];

const heroSlides = [
  {
    image: '/images/pulses-7.png',
    kicker: t.pages.home.eyebrow,
    title: t.pages.home.heroTitle,
    description: t.pages.home.heroSubtitle,
    alt: t.pages.home.heroImageAlt,
  },
  {
    image: '/images/pulses-4.png',
    kicker: t.pages.home.featuredTitle,
    title: t.pages.home.categoriesTitle,
    description: t.pages.home.featuredList[0] ?? t.pages.home.categoriesIntro,
    alt: t.pages.home.heroImageAlt,
  },
  {
    image: '/images/pulses-10.png',
    kicker: t.pages.solutions.eyebrow,
    title: t.pages.solutions.title,
    description: t.pages.solutions.intro,
    alt: t.pages.solutions.title,
  },
];
---

<Layout title={t.pages.home.title} lang={lang} translation={t}>
  <section class="trade-hero" data-trade-slideshow aria-label={t.pages.home.title}>
    <div class="trade-hero__images" aria-hidden="true">
      {heroSlides.map((slide, index) => (
        <div class:list={['trade-hero__image', index === 0 && 'is-active']} data-slide-image={index}>
          <img src={slide.image} alt="" loading={index === 0 ? 'eager' : 'lazy'} />
        </div>
      ))}
    </div>
    <div class="trade-hero__veil" aria-hidden="true"></div>
    <div class="trade-hero__grain" aria-hidden="true"></div>

    <div class="trade-hero__content">
      <div class="trade-hero__brand">
        <span class="trade-hero__brand-mark">ZM</span>
        <span>{t.labels.brand}</span>
      </div>

      <div class="trade-hero__copy-wrap">
        {heroSlides.map((slide, index) => (
          <div class:list={['trade-hero__copy', index === 0 && 'is-active']} data-slide-copy={index}>
            <p class="trade-hero__kicker">{slide.kicker}</p>
            <h1>{slide.title}</h1>
            <p class="trade-hero__description">{slide.description}</p>
            <div class="trade-hero__actions">
              <a class="trade-button trade-button--primary" href={withLanguagePrefix(lang, '/contact')}>
                {t.pages.home.ctaPrimary}
                <svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M3 13 13 3M5 3h8v8" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" /></svg>
              </a>
              <a class="trade-button trade-button--text" href={withLanguagePrefix(lang, '/products')}>
                {t.pages.home.ctaSecondary}
                <svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" /></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <div class="trade-hero__footer" dir="ltr">
        <div class="trade-hero__progress" aria-hidden="true"><span data-slide-progress></span></div>
        <div class="trade-hero__count"><span data-slide-current>01</span><span class="trade-hero__count-divider">/</span><span>{String(heroSlides.length).padStart(2, '0')}</span></div>
        <p class="trade-hero__footnote">{t.pages.home.categoriesTitle}</p>
      </div>
    </div>

    <div class="trade-hero__controls" dir="ltr">
      <div class="trade-hero__dots" role="tablist" aria-label={t.pages.home.title}>
        {heroSlides.map((slide, index) => (
          <button class:list={['trade-hero__dot', index === 0 && 'is-active']} type="button" data-slide-dot={index} role="tab" aria-selected={index === 0 ? 'true' : 'false'} aria-label={`${index + 1}`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
          </button>
        ))}
      </div>
      <div class="trade-hero__arrows">
        <button type="button" class="trade-hero__arrow" data-slide-prev aria-label="Previous slide"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M16 10H4m5-5-5 5 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" /></svg></button>
        <button type="button" class="trade-hero__arrow" data-slide-next aria-label="Next slide"><svg aria-hidden="true" viewBox="0 0 20 20" fill="none"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="square" stroke-linejoin="miter" /></svg></button>
      </div>
    </div>
  </section>

  <script>
    const slideshow = document.querySelector('[data-trade-slideshow]');

    if (slideshow) {
      const images = Array.from(slideshow.querySelectorAll('[data-slide-image]'));
      const copies = Array.from(slideshow.querySelectorAll('[data-slide-copy]'));
      const dots = Array.from(slideshow.querySelectorAll('[data-slide-dot]'));
      const current = slideshow.querySelector('[data-slide-current]');
      const progress = slideshow.querySelector('[data-slide-progress]');
      const next = slideshow.querySelector('[data-slide-next]');
      const previous = slideshow.querySelector('[data-slide-prev]');
      let activeIndex = 0;
      let timer;

      const setSlide = (nextIndex) => {
        activeIndex = (nextIndex + images.length) % images.length;
        images.forEach((item, index) => item.classList.toggle('is-active', index === activeIndex));
        copies.forEach((item, index) => item.classList.toggle('is-active', index === activeIndex));
        dots.forEach((item, index) => {
          item.classList.toggle('is-active', index === activeIndex);
          item.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');
        });
        if (current) current.textContent = String(activeIndex + 1).padStart(2, '0');
        if (progress) progress.style.width = `${((activeIndex + 1) / images.length) * 100}%`;
      };

      const restartTimer = () => {
        window.clearInterval(timer);
        timer = window.setInterval(() => setSlide(activeIndex + 1), 3500);
      };

      dots.forEach((dot, index) => dot.addEventListener('click', () => { setSlide(index); restartTimer(); }));
      next?.addEventListener('click', () => { setSlide(activeIndex + 1); restartTimer(); });
      previous?.addEventListener('click', () => { setSlide(activeIndex - 1); restartTimer(); });
      slideshow.addEventListener('mouseenter', () => window.clearInterval(timer));
      slideshow.addEventListener('mouseleave', restartTimer);
      setSlide(0);
      restartTimer();
    }
  </script>



  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="mb-10 text-center">
      <p class="section-eyebrow">{t.pages.home.eyebrow}</p>
      <h2 class="section-title">{t.pages.home.categoriesTitle}</h2>
      <span class="section-accent" aria-hidden="true"></span>
      <p class="mt-5 text-base text-slate-600 sm:text-lg">
        {t.pages.home.categoriesIntro}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {categoriesWithSpecs.map((category) => (
        <div class="card flex flex-col justify-between gap-5 p-6 transition hover:-translate-y-1 hover:shadow-2xl">
          <div class="space-y-4">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[#F3C623]/15 text-sm font-semibold text-[#19266A] ring-1 ring-[#F3C623]/40">
              {category.badge}
            </span>
            <div class="space-y-2">
              <h3 class="text-xl font-semibold text-[#19266A]">{category.name}</h3>
              <p class="text-slate-600">{category.description}</p>
              {category.specLine && (
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#19266A]/70">{category.specLine}</p>
              )}
            </div>
          </div>
          <a class="pill-link w-full border border-[#F3C623]/50 bg-[#F3C623]/10 text-[#19266A] hover:border-[#F3C623]/70 hover:bg-[#F3C623]/20" href={category.href}>
            {t.pages.home.ctaSecondary}
          </a>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16 ">
    <div class="section-surface">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.05fr,0.95fr] lg:items-center">
        <div class="space-y-4">
          <p class="section-eyebrow">{t.pages.resources.eyebrow}</p>
          <h2 class="section-title">{t.pages.resources.title}</h2>
          <span class="block h-[3px] w-16 rounded-full bg-[#F3C623]" aria-hidden="true"></span>
          <p class="text-base text-slate-600 sm:text-lg">{t.pages.resources.intro}</p>
          <div class="flex flex-wrap gap-3">
            <a class="pill-link border border-[#19266A]/15 bg-white text-[#19266A] shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg" href={withLanguagePrefix(lang, '/quality')}>
              {t.pages.home.ctaPrimary}
            </a>
            <a class="pill-link border border-[#F3C623]/50 bg-[#F3C623]/10 text-[#19266A] hover:bg-[#F3C623]/20" href={withLanguagePrefix(lang, '/products')}>
              {t.pages.home.ctaSecondary}
            </a>
          </div>
        </div>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 ">
          {complianceCards.map((card) => (
            <div class="card space-y-3 p-5 transition hover:-translate-y-1 hover:shadow-2xl">
              <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold text-[#19266A]">{card.title}</h3>
                <span class="badge-chip">{card.badge}</span>
              </div>
              <p class="text-sm text-slate-600">{card.description}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
    <div class="rounded-3xl bg-[#19266A] px-6 py-10 text-white shadow-2xl shadow-[#19266A]/40 sm:px-10">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-[#F3C623]">{t.pages.solutions.eyebrow}</p>
        <h2 class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">{t.pages.solutions.title}</h2>
        <span class="mx-auto mt-4 block h-[3px] w-16 rounded-full bg-[#F3C623]" aria-hidden="true"></span>
        <p class="mt-5 text-base text-white/75 sm:text-lg">{t.pages.solutions.intro}</p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {logisticsCards.map((solution) => (
          <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15">
            <div class="flex items-center justify-between">
              <h3 class="text-lg font-semibold text-white">{solution.title}</h3>
              <span class="badge-chip bg-white/10 text-white">{solution.tags[0]}</span>
            </div>
            <p class="mt-2 text-sm text-white/80">{solution.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {solution.tags.map((tag) => (
                <span class="rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white/80">{tag}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
        {exportSteps.map((step) => (
          <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/15">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#F3C623]">{step.title}</p>
            <p class="mt-2 text-sm text-white/80">{step.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a class="pill-link bg-[#F3C623] text-[#19266A] shadow-lg shadow-[#F3C623]/40 transition hover:-translate-y-0.5 hover:shadow-xl" href={withLanguagePrefix(lang, '/contact')}>
          {t.pages.home.ctaPrimary}
        </a>
        <a class="pill-link border border-white/30 bg-white/10 text-white hover:bg-white/20" href={withLanguagePrefix(lang, '/logistics')}>
          {t.pages.products.cta}
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-12 sm:px-6 sm:pb-16">
    <div class="mb-8 text-center">
      <p class="section-eyebrow">{t.pages.home.eyebrow}</p>
      <h2 class="section-title">{t.pages.home.industriesTitle}</h2>
      <span class="section-accent" aria-hidden="true"></span>
      <p class="mt-5 text-base text-slate-600 sm:text-lg">{t.pages.home.industriesIntro}</p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
      {industries.map((industry) => (
        <div class="card flex flex-col gap-3 p-5">
          <h3 class="text-lg font-semibold text-[#19266A]">{industry.name}</h3>
          <p class="text-slate-600">{industry.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
    <div class="mb-8 text-center">
      <p class="section-eyebrow">{t.pages.home.eyebrow}</p>
      <h2 class="section-title">{t.pages.home.faqTitle}</h2>
      <span class="section-accent" aria-hidden="true"></span>
      <p class="mt-5 text-base text-slate-600 sm:text-lg">{t.pages.home.faqIntro}</p>
    </div>
    <div class="space-y-4">
      {faq.map((item) => (
        <details class="card p-5">
          <summary class="flex cursor-pointer items-center justify-between gap-3 text-start text-base font-semibold text-[#19266A]">
            <span>{item.question}</span>
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#F3C623]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M12 4v16m8-8H4" />
            </svg>
          </summary>
          <p class="mt-3 text-sm text-slate-600">{item.answer}</p>
        </details>
      ))}
    </div>
    <div class="mt-8 text-center">
      <a class="pill-link border border-[#F3C623]/40 bg-[#F3C623] text-[#19266A] shadow-lg shadow-[#F3C623]/40 transition hover:-translate-y-0.5 hover:shadow-xl" href={withLanguagePrefix(lang, '/contact')}>
        {t.pages.home.ctaPrimary}
      </a>
    </div>
  </section>
</Layout>