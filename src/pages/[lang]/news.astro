---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';
import { getNewsPosts, formatNewsDate } from '../../data/news';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);

const posts = getNewsPosts(lang).map((post) => ({
  ...post,
  href: withLanguagePrefix(lang, `/news/${post.slug}`),
  displayDate: formatNewsDate(post.date, lang),
}));

const [lead, ...rest] = posts;
---

<Layout title={t.pages.news.title} lang={lang} translation={t}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="text-center">
      <p class="section-eyebrow">{t.pages.news.eyebrow}</p>
      <h1 class="section-title">{t.pages.news.title}</h1>
      <span class="section-accent" aria-hidden="true"></span>
      <p class="mx-auto mt-5 max-w-2xl text-base text-slate-600 sm:text-lg">{t.pages.news.intro}</p>
    </div>

    {posts.length === 0 && (
      <p class="mt-12 text-center text-slate-500">{t.pages.news.empty}</p>
    )}

    {lead && (
      <a href={lead.href} class="card group mt-12 grid overflow-hidden lg:grid-cols-2">
        <div class="relative min-h-56 overflow-hidden bg-[#19266A] lg:min-h-full">
          <img
            src={lead.image}
            alt=""
            loading="eager"
            class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
          />
        </div>
        <div class="flex flex-col justify-center gap-4 p-6 sm:p-9">
          <time datetime={lead.date} class="text-xs font-bold uppercase tracking-[0.18em] text-[#19266A]/50">
            {lead.displayDate}
          </time>
          <h2 class="text-2xl font-semibold leading-tight text-[#19266A] sm:text-3xl">{lead.title}</h2>
          <p class="leading-7 text-slate-600">{lead.excerpt}</p>
          <span class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A] transition group-hover:gap-3">
            {t.pages.news.readMore}
            <span aria-hidden="true">→</span>
          </span>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
        {rest.map((post) => (
          <a href={post.href} class="card group flex flex-col overflow-hidden">
            <div class="relative h-44 overflow-hidden bg-[#19266A]">
              <img
                src={post.image}
                alt=""
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
              />
            </div>
            <div class="flex flex-1 flex-col gap-3 p-5">
              <time datetime={post.date} class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#19266A]/50">
                {post.displayDate}
              </time>
              <h2 class="text-lg font-semibold leading-snug text-[#19266A]">{post.title}</h2>
              <p class="text-sm leading-6 text-slate-600">{post.excerpt}</p>
              <span class="mt-auto inline-flex items-center gap-2 pt-2 text-sm font-bold text-[#19266A] transition group-hover:gap-3">
                {t.pages.news.readMore}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>
