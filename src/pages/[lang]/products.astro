---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const stats = t.pages.home.stats;
const productImages: Record<string, string> = {
  chickpeas: '/images/pulses-1.jpg',
  lentils: '/images/pulses-6.jpg',
  beans: '/images/pulses-5.jpg',
  peas: '/images/pulses-3.jpg',
};
const productGallery = [
  '/images/pulses-2.jpg',
  '/images/pulses-4.jpg',
  '/images/pulses-7.jpg',
  '/images/logestic2.jpg',
];
---

<Layout title={t.pages.products.title} lang={lang} translation={t}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-dark/80">{t.pages.products.eyebrow}</p>
      <h1 class="section-title">{t.pages.products.title}</h1>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        {t.pages.products.intro}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="stat-tile">
          <span class="text-sm font-bold text-brand">{stat.value}</span>
          <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {productGallery.map((image) => (
        <div class="card overflow-hidden p-0">
          <img src={image} alt={t.pages.home.heroImageAlt} class="h-40 w-full object-cover" loading="lazy" />
        </div>
      ))}
    </div>

    {t.pages.products.sections.map((section) => (
      <section id={section.id} class="mt-12 sm:mt-16">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="flex items-center gap-3">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-brand-light text-xs font-semibold uppercase tracking-[0.18em] text-brand-dark">
                {section.badge}
              </span>
              <h2 class="text-2xl font-semibold text-brand-dark sm:text-3xl">{section.title}</h2>
            </div>
            <p class="mt-2 text-slate-600">{section.description}</p>
          </div>
          <a class="pill-link w-full border border-brand-gold/40 bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl sm:w-auto" href={withLanguagePrefix(lang, '/contact')}>
            {t.pages.products.cta}
          </a>
        </div>

        <div class="mt-6 grid grid-cols-1 gap-5 lg:grid-cols-[1fr,1.4fr]">
          <div class="card overflow-hidden p-0">
            <img
              src={productImages[section.id] ?? '/images/pulses-8.jpg'}
              alt={section.title}
              class="h-full min-h-[220px] w-full object-cover"
              loading="lazy"
            />
          </div>
          {section.products.map((product) => (
            <div class="card flex flex-col gap-4 p-5 transition hover:-translate-y-1 hover:shadow-2xl">
              <div class="flex items-start gap-3">
                <span class="mt-1 inline-flex h-10 w-10 items-center justify-center rounded-full bg-brand-light text-sm font-semibold uppercase tracking-wide text-brand-dark">
                  {product.tag.slice(0, 3).toUpperCase()}
                </span>
                <div>
                  <h3 class="text-lg font-semibold text-brand-dark">{product.name}</h3>
                  <p class="text-sm text-slate-600">{product.description}</p>
                </div>
              </div>
              <div class="flex flex-wrap gap-2">
                <span class="badge-chip"> {product.tag} </span>
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">{section.title}</span>
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}

    <section class="mt-14 rounded-3xl bg-brand-dark px-6 py-10 text-white shadow-2xl shadow-brand-dark/40 sm:px-10">
      <div class="flex flex-col gap-6 text-center lg:flex-row lg:items-center lg:justify-between lg:text-start">
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-gold/90">{t.pages.home.featuredTitle}</p>
          <h2 class="text-2xl font-semibold text-white sm:text-3xl">{t.pages.products.title}</h2>
          <p class="text-white/75">{t.pages.home.heroSubtitle}</p>
        </div>
        <div class="flex flex-wrap justify-center gap-3 lg:justify-end">
          <a class="pill-link bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl" href={withLanguagePrefix(lang, '/contact')}>
            {t.pages.home.ctaPrimary}
          </a>
          <a class="pill-link border border-white/30 bg-white/10 text-white hover:bg-white/20" href={withLanguagePrefix(lang, '/products')}>
            {t.pages.home.ctaSecondary}
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
