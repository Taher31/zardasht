const localePack = countryLocale[resolvedLang] ?? null;
const localizedName = localePack?.names?.[country.country_code] ?? country.country_name;
const localizedNotes = localePack?.notes?.[country.country_code] ?? country.notes;
const localizedCompliance = country.compliance_notes
  ? localePack?.compliance?.[country.compliance_notes] ?? country.compliance_notes
  : '';
const localizedExports = country.main_exports.map((item) => localePack?.exports?.[item] ?? item);
const title = `${localizedName} - ${t.pages.tradeMap.title}`;
const marketGallery = [
  '/images/pulses-1.jpg',
  '/images/pulses-6.jpg',
  '/images/logestic2.jpg',
];
---

<Layout title={title} lang={resolvedLang} translation={t}>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <img
        src={country.flag_url ?? `https://flagcdn.com/w320/${country.country_code.toLowerCase()}.png`}
        alt={`${localizedName} flag`}
        class="h-12 w-auto rounded-md ring-1 ring-slate-200"
        loading="lazy"
      />
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-dark/70">{t.pages.tradeMap.statusTraded}</p>
        <h1 class="text-3xl font-semibold text-brand-dark sm:text-4xl">{localizedName}</h1>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.deals_count}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.dealsLabel}</span>
      </div>
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.total_value}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.totalLabel}</span>
      </div>
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.last_deal_date}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.lastDealLabel}</span>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.capital ?? '—'}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.capitalLabel}</span>
      </div>
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.currency ?? '—'}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.currencyLabel}</span>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {marketGallery.map((image) => (
        <div class="card overflow-hidden p-0">
          <img src={image} alt={t.pages.home.heroImageAlt} class="h-32 w-full object-cover sm:h-36" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[1.1fr,0.9fr]">
      <div class="card space-y-4 p-6">
        <h2 class="text-xl font-semibold text-brand-dark">{t.pages.tradeMap.summaryTitle}</h2>
        <p class="text-slate-600">{localizedNotes}</p>
        {localizedCompliance && (
          <div class="rounded-xl bg-brand-light/60 px-4 py-3 text-sm text-brand-dark ring-1 ring-brand-light">
            <strong>{t.pages.tradeMap.complianceLabel}:</strong> {localizedCompliance}
          </div>
        )}
      </div>

      <div class="card space-y-4 p-6">
        <h2 class="text-xl font-semibold text-brand-dark">{t.pages.tradeMap.shipTitle}</h2>
        <ul class="space-y-2 text-slate-600">
          {localizedExports.map((item) => (
            <li class="flex items-start gap-2">
              <span class="mt-1 h-2 w-2 rounded-full bg-brand-gold"></span>
              {item}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        class="pill-link bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl"
        href={`/${resolvedLang}/contact`}
      >
        {t.pages.home.ctaPrimary}
      </a>
      <a class="pill-link border border-brand-gold/40 bg-white text-brand-dark hover:bg-brand-gold/10" href={`/${resolvedLang}/trade-map`}>
        {t.pages.tradeMap.ctaBack}
      </a>
    </div>
  </section>
</Layout>
