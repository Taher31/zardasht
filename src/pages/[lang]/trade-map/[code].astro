      'Red split lentils': 'Красная колотая чечевица',
      'Red lentils': 'Красная чечевица',
      'Green lentils': 'Зелёная чечевица',
      'Green peas': 'Зелёный горох',
      'Yellow peas': 'Жёлтый горох',
      'White beans': 'Белая фасоль',
      'Kidney beans': 'Красная фасоль',
      Beans: 'Фасоль',
      'LSKB beans': 'Фасоль LSKB',
      'Pinto beans': 'Фасоль пинто',
    },
    compliance: {
      'Requires phytosanitary and fumigation certificates.': 'Требуются фитосанитарный и фумигационный сертификаты.',
