      'Red lentils': 'عدس أحمر',
      'Green lentils': 'عدس أخضر',
      'Green peas': 'بازلاء خضراء',
      'Yellow peas': 'بازلاء صفراء',
      'White beans': 'فاصوليا بيضاء',
