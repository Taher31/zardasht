---
import Layout from '../../../layouts/Layout.astro';
import { getTranslation, resolveLang, localizedLanguages } from '../../../i18n';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'public', 'data', 'trade-countries.json');
  const tradeCountries = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  return localizedLanguages.flatMap((language) =>
    tradeCountries
      .filter((c) => c.status)
      .map((country) => ({
        params: { lang: language.code, code: country.country_code.toLowerCase() },
        props: { country, lang: language.code },
      })),
  );
}

const { country, lang } = Astro.props;
const resolvedLang = resolveLang(lang);
const t = getTranslation(resolvedLang);
const countryLocale = {
