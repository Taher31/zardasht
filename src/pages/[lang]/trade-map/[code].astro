---
import Layout from '../../../layouts/Layout.astro';
import { getTranslation, resolveLang, localizedLanguages } from '../../../i18n';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dataPath = path.join(process.cwd(), 'public', 'data', 'trade-countries.json');
  const tradeCountries = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
  return localizedLanguages.flatMap((language) =>
    tradeCountries
      .filter((c) => c.status)
      .map((country) => ({
        params: { lang: language.code, code: country.country_code.toLowerCase() },
        props: { country, lang: language.code },
      })),
  );
}

const { country, lang } = Astro.props;
const resolvedLang = resolveLang(lang);
const t = getTranslation(resolvedLang);

const countryLocale = {
  fa: {
    names: {
      UZ: 'ازبکستان',
      RU: 'روسیه',
    },
    notes: {
      UZ: 'صادرات قیر و واردات نخ ابریشم بر اساس مشخصات و شرایط تحویل توافق‌شده.',
      RU: 'تأمین جو برای واردات در چارچوب سبد کالاهای کشاورزی.',
    },
    items: {
      Bitumen: 'قیر',
      'Silk yarn': 'نخ ابریشم',
      Barley: 'جو',
    },
    compliance: {
      'Export and import documentation confirmed per shipment.': 'مدارک صادرات و واردات برای هر محموله تأیید می‌شود.',
      'Quality specification and shipping documentation confirmed per shipment.':
        'مشخصات کیفی و مدارک حمل برای هر محموله تأیید می‌شود.',
    },
  },
  ar: {
    names: {
      UZ: 'أوزبكستان',
      RU: 'روسيا',
    },
    notes: {
      UZ: 'تصدير البيتومين واستيراد خيوط الحرير وفق المواصفات وشروط التسليم المتفق عليها.',
      RU: 'توريد الشعير للاستيراد ضمن محفظة السلع الزراعية.',
    },
    items: {
      Bitumen: 'البيتومين',
      'Silk yarn': 'خيوط الحرير',
      Barley: 'الشعير',
    },
    compliance: {
      'Export and import documentation confirmed per shipment.': 'تُؤكَّد مستندات التصدير والاستيراد لكل شحنة.',
      'Quality specification and shipping documentation confirmed per shipment.':
        'تُؤكَّد مواصفات الجودة ومستندات الشحن لكل شحنة.',
    },
  },
  ru: {
    names: {
      UZ: 'Узбекистан',
      RU: 'Россия',
    },
    notes: {
      UZ: 'Экспорт битума и импорт шёлковой пряжи по согласованным спецификациям и условиям поставки.',
      RU: 'Закупка ячменя для импорта в рамках сельскохозяйственного портфеля.',
    },
    items: {
      Bitumen: 'Битум',
      'Silk yarn': 'Шёлковая пряжа',
      Barley: 'Ячмень',
    },
    compliance: {
      'Export and import documentation confirmed per shipment.': 'Документы на экспорт и импорт подтверждаются по каждой поставке.',
      'Quality specification and shipping documentation confirmed per shipment.':
        'Спецификация качества и отгрузочные документы подтверждаются по каждой поставке.',
    },
  },
};

const localePack = countryLocale[resolvedLang] ?? null;
const localizedName = localePack?.names?.[country.country_code] ?? country.country_name;
const localizedNotes = localePack?.notes?.[country.country_code] ?? country.notes;
const localizedCompliance = country.compliance_notes
  ? localePack?.compliance?.[country.compliance_notes] ?? country.compliance_notes
  : '';
const localizedExports = (country.main_exports ?? []).map((item) => localePack?.items?.[item] ?? item);
const localizedImports = (country.main_imports ?? []).map((item) => localePack?.items?.[item] ?? item);
const hasExports = localizedExports.length > 0;
const hasImports = localizedImports.length > 0;
const title = `${localizedName} - ${t.pages.tradeMap.title}`;

const galleryByCountry: Record<string, string[]> = {
  UZ: ['/images/02_bitumen.jpg', '/images/05_textile_yarn.jpg', '/images/01_global_shipping_port.jpg'],
  RU: ['/images/04_agricultural_grain.jpg', '/images/07_rail_logistics.jpg', '/images/01_global_shipping_port.jpg'],
};
const marketGallery = galleryByCountry[country.country_code] ?? ['/images/01_global_shipping_port.jpg'];
---

<Layout title={title} lang={resolvedLang} translation={t}>
  <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 sm:py-14">
    <div class="mb-8 flex flex-wrap items-center gap-4">
      <img
        src={`https://flagcdn.com/w320/${country.country_code.toLowerCase()}.png`}
        alt={`${localizedName} flag`}
        class="h-12 w-auto rounded-md ring-1 ring-slate-200"
        loading="lazy"
      />
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.22em] text-brand-dark/70">{t.pages.tradeMap.statusTraded}</p>
        <h1 class="text-3xl font-semibold text-brand-dark sm:text-4xl">{localizedName}</h1>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.capital ?? '—'}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.capitalLabel}</span>
      </div>
      <div class="stat-tile">
        <span class="text-sm font-bold text-brand">{country.currency ?? '—'}</span>
        <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{t.pages.tradeMap.currencyLabel}</span>
      </div>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {marketGallery.map((image) => (
        <div class="card overflow-hidden p-0">
          <img src={image} alt={t.pages.home.heroImageAlt} class="h-32 w-full object-cover sm:h-36" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-[1.1fr,0.9fr]">
      <div class="card space-y-4 p-6">
        <h2 class="text-xl font-semibold text-brand-dark">{t.pages.tradeMap.summaryTitle}</h2>
        <p class="text-slate-600">{localizedNotes}</p>
        {localizedCompliance && (
          <div class="rounded-xl bg-brand-light/60 px-4 py-3 text-sm text-brand-dark ring-1 ring-brand-light">
            <strong>{t.pages.tradeMap.complianceLabel}:</strong> {localizedCompliance}
          </div>
        )}
      </div>

      <div class="card space-y-4 p-6">
        {hasExports && (
          <div>
            <h2 class="text-xl font-semibold text-brand-dark">{t.pages.tradeMap.shipTitle}</h2>
            <ul class="mt-2 space-y-2 text-slate-600">
              {localizedExports.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-2 w-2 rounded-full bg-brand-gold"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}
        {hasImports && (
          <div class:list={[hasExports && 'mt-6 border-t border-slate-100 pt-6']}>
            <h2 class="text-xl font-semibold text-brand-dark">{t.pages.tradeMap.importsTitle}</h2>
            <ul class="mt-2 space-y-2 text-slate-600">
              {localizedImports.map((item) => (
                <li class="flex items-start gap-2">
                  <span class="mt-1 h-2 w-2 rounded-full bg-brand-gold"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>

    <div class="mt-8 flex flex-wrap gap-3">
      <a
        class="pill-link bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl"
        href={`/${resolvedLang}/contact`}
      >
        {t.pages.home.ctaPrimary}
      </a>
      <a class="pill-link border border-brand-gold/40 bg-white text-brand-dark hover:bg-brand-gold/10" href={`/${resolvedLang}/trade-map`}>
        {t.pages.tradeMap.ctaBack}
      </a>
    </div>
  </section>
</Layout>
