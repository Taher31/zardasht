---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, localizedLanguages } from '../../i18n';
import { WHATSAPP_NUMBER, WHATSAPP_URL } from '../../config/contact';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const trustBadges = t.pages.home.trustBadges;
const contactLabels: Record<string, { email: string; phone: string; address: string }> = {
  en: { email: 'Email', phone: 'Phone', address: 'Address' },
  fa: { email: 'ایمیل', phone: 'تلفن', address: 'آدرس' },
  ar: { email: 'البريد الإلكتروني', phone: 'الهاتف', address: 'العنوان' },
  ru: { email: 'Эл. почта', phone: 'Телефон', address: 'Адрес' },
};
const contactLabel = contactLabels[lang] ?? contactLabels.en;
const whatsappIntro: Record<string, string> = {
  en: 'Hello, I’m contacting you through the Zardasht Mahd Binaloud Trading website and would like to request a quotation.',
  fa: 'سلام، من از طریق وب‌سایت شرکت بازرگانی زردشت مهد بینالود با شما ارتباط گرفته‌ام و مایل به دریافت پیش‌فاکتور هستم.',
  ar: 'مرحباً، أتواصل معكم عبر موقع شركة زردشت مهد بينالود للتجارة وأرغب في طلب عرض سعر.',
  ru: 'Здравствуйте! Я связываюсь с вами через сайт Zardasht Mahd Binaloud Trading и хотел(а) бы запросить коммерческое предложение.',
};
const localizedWhatsappIntro = whatsappIntro[lang] ?? whatsappIntro.en;
const contactGallery = [
  '/images/pulses-2.jpg',
  '/images/logestic1.jpg',
  '/images/pulses-8.jpg',
];
---

<Layout title={t.pages.contact.title} lang={lang} translation={t}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="text-center">
      <div class="mb-4 flex justify-center">
        <span class="inline-flex h-10 w-16 items-center justify-center overflow-hidden rounded-xl bg-white/90 ring-1 ring-brand-light">
          <img src="/images/iran-flag.jpg" alt="Iran flag" class="h-full w-full object-cover" loading="lazy" />
        </span>
      </div>
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-dark/80">{t.pages.contact.eyebrow}</p>
      <h1 class="section-title">{t.pages.contact.title}</h1>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        {t.pages.contact.intro}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {contactGallery.map((image) => (
        <div class="card overflow-hidden p-0">
          <img src={image} alt={t.pages.home.heroImageAlt} class="h-40 w-full object-cover sm:h-44" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-8 lg:grid-cols-[1.1fr,0.9fr]">
      <div class="space-y-5 rounded-2xl bg-white/90 p-6 shadow-lg ring-1 ring-brand-light backdrop-blur">
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-dark">{contactLabel.email}</p>
            <p class="text-base font-semibold text-slate-800">{t.pages.contact.email}</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-dark">{contactLabel.phone}</p>
            <a href={WHATSAPP_URL} target="_blank" rel="noreferrer" dir="ltr" class="text-base font-semibold text-slate-800 transition hover:text-brand">
              {t.pages.contact.phone}
            </a>
          </div>
          <div class="sm:col-span-2">
            <p class="text-xs font-semibold uppercase tracking-[0.24em] text-brand-dark">{contactLabel.address}</p>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <span class="inline-flex h-6 w-10 items-center justify-center overflow-hidden rounded-sm ring-1 ring-brand-light">
                <img src="/images/iran-flag.jpg" alt="Iran flag" class="h-full w-full object-cover" loading="lazy" />
              </span>
              <p class="text-base font-semibold text-slate-800">{t.pages.contact.address}</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-2 rounded-xl bg-brand-light/70 p-4 ring-1 ring-brand-light">
          {t.pages.contact.quickLinks.map((item) => (
            <div class="flex items-center justify-between rounded-lg bg-white px-3 py-2 text-sm font-semibold text-brand-dark shadow-sm ring-1 ring-brand-light">
              <span>{item}</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M5 12h14m-7-7 7 7-7 7" />
              </svg>
            </div>
          ))}
        </div>
      </div>

      <form id="whatsapp-quote-form" data-whatsapp-number={WHATSAPP_NUMBER} data-whatsapp-intro={localizedWhatsappIntro} class="space-y-4 rounded-2xl bg-white/95 p-6 shadow-lg ring-1 ring-brand-light backdrop-blur">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.name}</label>
            <input name="name" required autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.name} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.company}</label>
            <input name="company" autocomplete="organization" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.company} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.country}</label>
            <input name="country" autocomplete="country-name" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.country} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.email}</label>
            <input name="email" autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="email" placeholder={t.pages.contact.form.email} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.phone}</label>
            <input name="phone" autocomplete="tel" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.phone} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.product}</label>
            <input name="product" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.product} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.quantity}</label>
            <input name="quantity" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.quantity} />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.destination}</label>
            <input name="destination" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.destination} />
          </div>
          <div class="sm:col-span-2">
            <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.incoterms}</label>
            <input name="incoterms" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" type="text" placeholder={t.pages.contact.form.incoterms} />
          </div>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.message}</label>
          <textarea name="message" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-brand focus:outline-none focus:ring-2 focus:ring-brand-light" rows="5" placeholder={t.pages.contact.form.message}></textarea>
        </div>
        <button class="pill-link w-full border border-brand-gold/40 bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl" type="submit">
          {t.pages.contact.form.submit}
        </button>
      </form>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {trustBadges.map((badge) => (
        <div class="card flex flex-col gap-2 p-5">
          <span class="badge-chip">{badge.title}</span>
          <p class="text-sm text-slate-600">{badge.description}</p>
        </div>
      ))}
    </div>
  </div>

  <script>
    const whatsappForm = document.querySelector<HTMLFormElement>('#whatsapp-quote-form');

    whatsappForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(whatsappForm);
      const value = (key: string) => String(formData.get(key) ?? '').trim();
      const lines = [
        whatsappForm.dataset.whatsappIntro ?? 'Hello, I would like to request a quotation.',
        '',
        `Name: ${value('name')}`,
        `Company: ${value('company') || '—'}`,
        `Country: ${value('country') || '—'}`,
        `Email: ${value('email') || '—'}`,
        `Phone / WhatsApp: ${value('phone') || '—'}`,
        `Product & grade: ${value('product')}`,
        `Quantity: ${value('quantity')}`,
        `Destination port: ${value('destination')}`,
        `Incoterms: ${value('incoterms') || '—'}`,
        '',
        `Message: ${value('message') || '—'}`,
      ];
      const number = whatsappForm.dataset.whatsappNumber;
      if (!number) return;
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
