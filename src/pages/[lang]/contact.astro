---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';
import { metaDescription } from '../../data/meta-descriptions';
import { WHATSAPP_NUMBER, WHATSAPP_URL } from '../../config/contact';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const trustBadges = t.pages.home.trustBadges;

const quickLinks = [
  { label: t.pages.contact.quickLinks[0], href: '#trade-inquiry' },
  { label: t.pages.contact.quickLinks[1], href: withLanguagePrefix(lang, '/products') },
  { label: t.pages.contact.quickLinks[2], href: withLanguagePrefix(lang, '/trade-map') },
];

const productGroups = [
  { code: 'EB', label: t.labels.trade.energyBitumen },
  { code: 'MS', label: t.labels.trade.metalsSteel },
  { code: 'AG', label: t.labels.trade.agriculturalCommodities },
  { code: 'CP', label: t.labels.trade.chemicalsPetrochemicals },
  { code: 'TX', label: t.labels.trade.textileRawMaterials },
];

const whatsappGreetingUrl = `${WHATSAPP_URL}?text=${encodeURIComponent(t.pages.contact.whatsappGreeting)}`;
---

<Layout
  title={t.pages.contact.title}
  lang={lang}
  translation={t}
  description={metaDescription(lang, 'contact') ?? t.pages.contact.intro}
  breadcrumbs={[{ name: t.pages.contact.title, href: withLanguagePrefix(lang, '/contact') }]}
>
  <main>
    <section>
      <div class="mx-auto max-w-6xl px-4 py-12 text-center sm:px-6 sm:py-16">
        <div class="mx-auto mb-5 flex h-12 w-12 items-center justify-center rounded-full border border-[#19266A]/10 bg-white shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-[#F3C623]"></span>
        </div>
        <p class="section-eyebrow">{t.pages.contact.eyebrow}</p>
        <h1 class="mx-auto mt-3 max-w-4xl text-4xl font-semibold tracking-tight text-[#19266A] sm:text-5xl">
          {t.pages.contact.title}
        </h1>
        <p class="mx-auto mt-5 max-w-3xl text-base leading-8 text-slate-600 sm:text-lg">
          {t.pages.contact.intro}
        </p>
      </div>
    </section>

    <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-[0.82fr,1.18fr] lg:items-start">
        <aside class="space-y-6 lg:sticky lg:top-32">
          <section class="overflow-hidden rounded-3xl bg-[#10184A] p-6 text-white shadow-2xl shadow-[#19266A]/20 sm:p-7">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#F3C623]">{t.labels.trade.tagline}</p>
            <h2 class="mt-3 text-2xl font-semibold text-white">{t.labels.trade.inquiry}</h2>

            <div class="mt-6 space-y-5 border-t border-white/10 pt-6">
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/45">{t.pages.contact.form.email}</p>
                <a href={`mailto:${t.pages.contact.email}`} dir="ltr" class="mt-1 inline-block text-sm font-semibold text-white transition hover:text-[#F3C623]" data-copy-email={t.pages.contact.email}>
                  {t.pages.contact.email}
                </a>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/45">{t.pages.contact.form.phone}</p>
                <a href={whatsappGreetingUrl} target="_blank" rel="noreferrer" dir="ltr" class="mt-1 inline-block text-sm font-semibold text-white transition hover:text-[#F3C623]">
                  {t.pages.contact.phone}
                </a>
              </div>
              <div>
                <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/45">{t.pages.contact.addressLabel}</p>
                <div class="mt-2 flex items-start gap-3">
                  <span class="mt-0.5 inline-flex h-5 w-8 shrink-0 overflow-hidden rounded-sm ring-1 ring-white/15">
                    <img src="/images/iran-flag.webp" alt="Iran flag" class="h-full w-full object-cover" width="297" height="170" loading="lazy" />
                  </span>
                  <p class="text-sm leading-6 text-white/75">{t.pages.contact.address}</p>
                </div>
              </div>
            </div>
          </section>

          <section class="rounded-3xl border border-[#19266A]/10 bg-white p-6 shadow-sm">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#19266A]/50">{t.labels.trade.productGroups}</p>
            <div class="mt-4 grid grid-cols-2 gap-3">
              {productGroups.map((group) => (
                <a
                  href={withLanguagePrefix(lang, `/products/${group.code === 'EB' ? 'energy-bitumen' : group.code === 'MS' ? 'metals-steel' : group.code === 'AG' ? 'agricultural-commodities' : 'textile-raw-materials'}`)}
                  class="rounded-2xl border border-[#19266A]/10 bg-slate-50 p-4 transition hover:border-[#F3C623]/60 hover:bg-[#F3C623]/10"
                >
                  <span class="text-[10px] font-extrabold tracking-[0.16em] text-[#19266A]/45">{group.code}</span>
                  <p class="mt-1 text-sm font-semibold text-[#19266A]">{group.label}</p>
                </a>
              ))}
            </div>
          </section>

          <nav class="grid gap-2" aria-label={t.pages.contact.eyebrow}>
            {quickLinks.map((item) => (
              <a class="flex items-center justify-between rounded-2xl border border-[#19266A]/10 bg-white px-4 py-3 text-sm font-semibold text-[#19266A] transition hover:border-[#19266A]/20 hover:bg-[#19266A]/5" href={item.href}>
                <span>{item.label}</span>
                <span aria-hidden="true">→</span>
              </a>
            ))}
          </nav>
        </aside>

        <section id="trade-inquiry" class="scroll-mt-32 rounded-3xl border border-[#19266A]/10 bg-white p-6 shadow-[0_24px_60px_-36px_rgba(25,38,106,.4)] sm:p-8">
          <div class="mb-7">
            <p class="text-xs font-bold uppercase tracking-[0.22em] text-[#19266A]/50">{t.pages.contact.eyebrow}</p>
            <h2 class="mt-2 text-2xl font-semibold text-[#19266A] sm:text-3xl">{t.labels.trade.inquiry}</h2>
            <p class="mt-3 text-sm leading-6 text-slate-600">{t.pages.contact.intro}</p>
          </div>

          <form
            id="whatsapp-quote-form"
            data-whatsapp-number={WHATSAPP_NUMBER}
            data-whatsapp-intro={t.pages.contact.whatsappIntro}
            data-label-name={t.pages.contact.form.name}
            data-label-company={t.pages.contact.form.company}
            data-label-country={t.pages.contact.form.country}
            data-label-email={t.pages.contact.form.email}
            data-label-phone={t.pages.contact.form.phone}
            data-label-product={t.pages.contact.form.product}
            data-label-quantity={t.pages.contact.form.quantity}
            data-label-destination={t.pages.contact.form.destination}
            data-label-incoterms={t.pages.contact.form.incoterms}
            data-label-message={t.pages.contact.form.message}
            class="space-y-5"
          >
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.name}</label>
                <input name="name" required autocomplete="name" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.name} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.company}</label>
                <input name="company" autocomplete="organization" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.company} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.country}</label>
                <input name="country" autocomplete="country-name" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.country} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.email}</label>
                <input name="email" autocomplete="email" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="email" placeholder={t.pages.contact.form.email} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.phone}</label>
                <input name="phone" autocomplete="tel" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.phone} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.product}</label>
                <input name="product" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.product} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.quantity}</label>
                <input name="quantity" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.quantity} />
              </div>
              <div>
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.destination}</label>
                <input name="destination" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.destination} />
              </div>
              <div class="sm:col-span-2">
                <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.incoterms}</label>
                <input name="incoterms" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" type="text" placeholder={t.pages.contact.form.incoterms} />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-slate-800">{t.pages.contact.form.message}</label>
              <textarea name="message" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm focus:border-[#19266A] focus:outline-none focus:ring-2 focus:ring-[#19266A]/10" rows="5" placeholder={t.pages.contact.form.message}></textarea>
            </div>

            <button class="pill-link w-full bg-[#F3C623] text-[#10184A] shadow-lg shadow-[#F3C623]/25 transition hover:-translate-y-0.5 hover:shadow-xl" type="submit">
              {t.pages.contact.form.submit}
            </button>
          </form>
        </section>
      </div>

      <section class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {trustBadges.map((badge) => (
          <div class="card flex flex-col gap-2 p-5">
            <span class="badge-chip">{badge.title}</span>
            <p class="text-sm leading-6 text-slate-600">{badge.description}</p>
          </div>
        ))}
      </section>
    </div>
  </main>

  <script>
    const whatsappForm = document.querySelector<HTMLFormElement>('#whatsapp-quote-form');

    whatsappForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      const formData = new FormData(whatsappForm);
      const value = (key: string) => String(formData.get(key) ?? '').trim();
      const label = (key: string, fallback: string) => whatsappForm.dataset[`label${key}`] ?? fallback;
      const lines = [
        whatsappForm.dataset.whatsappIntro ?? 'Hello, I would like to discuss a commodity trade inquiry.',
        '',
        `${label('Name', 'Name')}: ${value('name')}`,
        `${label('Company', 'Company')}: ${value('company') || '—'}`,
        `${label('Country', 'Country')}: ${value('country') || '—'}`,
        `${label('Email', 'Email')}: ${value('email') || '—'}`,
        `${label('Phone', 'Phone / WhatsApp')}: ${value('phone') || '—'}`,
        `${label('Product', 'Commodity & specification')}: ${value('product')}`,
        `${label('Quantity', 'Quantity')}: ${value('quantity')}`,
        `${label('Destination', 'Origin / destination')}: ${value('destination')}`,
        `${label('Incoterms', 'Preferred delivery terms')}: ${value('incoterms') || '—'}`,
        '',
        `${label('Message', 'Notes / requirements')}: ${value('message') || '—'}`,
      ];
      const number = whatsappForm.dataset.whatsappNumber;
      if (!number) return;
      window.open(`https://wa.me/${number}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener,noreferrer');
    });
  </script>
</Layout>
