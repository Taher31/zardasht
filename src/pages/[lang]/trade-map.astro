---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, localizedLanguages, withLanguagePrefix } from '../../i18n';
import fs from 'node:fs';
import path from 'node:path';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);

const dataPath = path.join(process.cwd(), 'public', 'data', 'trade-countries.json');
const tradeCountries = JSON.parse(fs.readFileSync(dataPath, 'utf-8'));
const activeCountries = tradeCountries.filter((country) => country.status);
const activeCount = activeCountries.length;
const mapStrings = {
  statusTraded: t.pages.tradeMap.statusTraded,
  statusNotTraded: t.pages.tradeMap.statusNotTraded,
  statusLabel: t.pages.tradeMap.statusLabel,
  dealsLabel: t.pages.tradeMap.dealsLabel,
  totalLabel: t.pages.tradeMap.totalLabel,
};
const fxStrings = {
  title: t.pages.tradeMap.fxTitle,
  baseLabel: t.pages.tradeMap.fxBaseLabel,
  updatedLabel: t.pages.tradeMap.fxUpdatedLabel,
  loading: t.pages.tradeMap.fxLoading,
  error: t.pages.tradeMap.fxError,
};

const countryNames: Record<string, string> = {
  UZ: lang === 'fa' ? 'ازبکستان' : lang === 'ar' ? 'أوزبكستان' : lang === 'ru' ? 'Узбекистан' : 'Uzbekistan',
  RU: lang === 'fa' ? 'روسیه' : lang === 'ar' ? 'روسيا' : lang === 'ru' ? 'Россия' : 'Russia',
};
---

<Layout title={t.pages.tradeMap.title} lang={lang} translation={t}>
  <section class="mx-auto w-full max-w-none px-4 py-10 sm:px-8 lg:px-12">
    <div class="mb-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-dark/80">{t.pages.tradeMap.title}</p>
      <h1 class="section-title">{t.pages.tradeMap.title}</h1>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        {t.pages.tradeMap.intro}
      </p>
      <p class="mt-2 text-sm font-semibold text-brand-dark/80">{activeCount} {t.pages.tradeMap.activeCountLabel}</p>
    </div>

    <div class="relative hidden overflow-hidden rounded-3xl bg-white p-4 pb-0 shadow-xl ring-1 ring-brand-light sm:block sm:p-6 sm:pb-6 lg:p-8 lg:pb-8">
      <div id="trade-map" class="w-full"></div>
      <div
        id="map-tooltip"
        class="pointer-events-none absolute z-20 hidden max-w-xs rounded-lg bg-slate-900/95 px-3 py-2 text-xs font-semibold text-white shadow-lg backdrop-blur"
      ></div>
    </div>

    <!-- Mobile fallback: the interactive SVG map only renders at sm+, so give small screens the same active markets as cards. -->
    <div class="grid grid-cols-1 gap-4 sm:hidden">
      {activeCountries.map((country) => (
        <a
          href={withLanguagePrefix(lang, `/trade-map/${country.country_code.toLowerCase()}`)}
          class="card flex items-center gap-4 p-4 transition hover:-translate-y-0.5 hover:shadow-lg"
        >
          <img
            src={`https://flagcdn.com/w320/${country.country_code.toLowerCase()}.png`}
            alt=""
            class="h-10 w-14 shrink-0 rounded-md object-cover ring-1 ring-slate-200"
            loading="lazy"
          />
          <div class="min-w-0 flex-1">
            <p class="truncate text-base font-semibold text-brand-dark">
              {countryNames[country.country_code] ?? country.country_name}
            </p>
            <p class="truncate text-sm text-slate-600">{country.notes}</p>
          </div>
          <span class="badge-chip shrink-0">{t.pages.tradeMap.statusTraded}</span>
        </a>
      ))}
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3 text-sm text-slate-600">
      <span class="inline-flex items-center gap-2 rounded-full bg-brand-light px-3 py-1 font-semibold text-brand-dark">
        {t.pages.tradeMap.highlightLegend}
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1 font-semibold text-slate-700">
        {t.pages.tradeMap.greyLegend}
      </span>
    </div>

    <div class="mt-6 card space-y-3 p-5" id="fx-rates">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="text-xs font-semibold uppercase tracking-[0.22em] text-brand-dark/70">
          {t.pages.tradeMap.fxTitle}
        </p>
        <p class="text-xs text-slate-500" id="fx-base">
          {t.pages.tradeMap.fxBaseLabel}: IRR
        </p>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="stat-tile">
          <span class="text-sm font-bold text-brand" id="fx-irr-usd">—</span>
          <span class="text-xs uppercase tracking-[0.18em] text-slate-600">USD</span>
        </div>
        <div class="stat-tile">
          <span class="text-sm font-bold text-brand" id="fx-irr-aed">—</span>
          <span class="text-xs uppercase tracking-[0.18em] text-slate-600">AED</span>
        </div>
      </div>
      <p class="text-xs text-slate-500" id="fx-meta">{t.pages.tradeMap.fxLoading}</p>
    </div>

    <p class="mt-4 text-center text-sm text-slate-600">
      {t.pages.tradeMap.selectPrompt}
    </p>
  </section>

  <script type="application/json" id="trade-data" set:html={JSON.stringify(activeCountries)}></script>
  <script type="application/json" id="map-locale" set:html={JSON.stringify(mapStrings)}></script>
  <script type="application/json" id="fx-locale" set:html={JSON.stringify(fxStrings)}></script>

  <script src="/vendor/d3.min.js" defer></script>
  <script src="/scripts/trade-map.js" defer></script>
  <script src="/scripts/fx-rates.js" defer></script>
</Layout>
