---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../../i18n';
import { imageSize } from '../../../data/image-size';
import { groupAccents, groupFallbackImage } from '../../../data/product-groups';
import { groupMetaDescription } from '../../../data/meta-descriptions';
import productsData from '../../../data/products.json';

/**
 * One page per commodity group.
 *
 * These used to be anchors on /products, which meant the five groups competed
 * for a single URL: a search for "bitumen export Iran" and one for "barley
 * supplier Russia" both had to be answered by the same page. Each group now
 * has its own address, title, description and share image, and /products is
 * the hub that links to them.
 */
export function getStaticPaths() {
  // The group ids are the same in every locale, so English defines the routes.
  return localizedLanguages.flatMap((language) =>
    productsData.en.map((section) => ({
      params: { lang: language.code, group: section.id },
      props: { group: section.id, lang: language.code },
    })),
  );
}

const { group, lang: langProp } = Astro.props;
const lang = resolveLang(langProp ?? Astro.params.lang);
const t = getTranslation(lang);

const sections = t.pages.products.sections;
const section = sections.find((entry) => entry.id === group)!;
const others = sections.filter((entry) => entry.id !== group);

const accent = groupAccents[section.id] ?? { code: '00', note: section.badge, image: groupFallbackImage };
const groupHref = withLanguagePrefix(lang, `/products/${section.id}`);
const origin = (Astro.site ?? Astro.url).origin;

// The four entries under a group are how we supply it, not SKUs with a price,
// so the honest shape is an ItemList of offerings rather than Product schema.
const groupSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: section.title,
  description: section.description,
  inLanguage: lang,
  url: `${origin}${groupHref}`,
  isPartOf: { '@id': `${origin}/#website` },
  about: { '@id': `${origin}/#organization` },
  mainEntity: {
    '@type': 'ItemList',
    name: section.title,
    numberOfItems: section.products.length,
    itemListElement: section.products.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: product.name,
      description: product.description,
    })),
  },
};
---

<Layout
  title={section.title}
  lang={lang}
  translation={t}
  description={groupMetaDescription(lang, section.id) ?? section.description}
  image={accent.image}
  imageAlt={section.title}
  breadcrumbs={[
    { name: t.pages.products.title, href: withLanguagePrefix(lang, '/products') },
    { name: section.title, href: groupHref },
  ]}
  schema={[groupSchema]}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <a
      class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A]/70 transition hover:text-[#19266A]"
      href={withLanguagePrefix(lang, '/products')}
    >
      <span aria-hidden="true">←</span>
      {t.pages.products.title}
    </a>

    <!-- Group header: the same navy panel treatment the hub uses, so moving
         from /products to a group page reads as going deeper, not sideways. -->
    <section class="mt-8 overflow-hidden rounded-3xl bg-[#10184A] text-white shadow-2xl shadow-[#19266A]/25">
      <div class="grid lg:grid-cols-[0.85fr,1.15fr]">
        <div class="relative min-h-[240px] overflow-hidden lg:min-h-[340px]">
          {accent.video ? (
            <video
              class="absolute inset-0 h-full w-full object-cover"
              poster={accent.image}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
              data-fallback-video
              data-fallback={accent.image}
              data-fallback-width={imageSize(accent.image).width}
              data-fallback-height={imageSize(accent.image).height}
              data-video-src={accent.video}
            ></video>
          ) : (
            <img
              src={accent.image}
              alt=""
              loading="eager"
              class="absolute inset-0 h-full w-full object-cover"
              {...imageSize(accent.image)}
            />
          )}
          <div class="absolute inset-0 bg-gradient-to-t from-[#10184A]/90 via-[#10184A]/45 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-[#10184A]/85"></div>
        </div>

        <div class="flex flex-col justify-center p-7 sm:p-10">
          <!-- `accent.note` is deliberately not shown here: it carries the
               same two letters as `section.badge`, which reads as a stutter
               when the two sit side by side. -->
          <div class="flex items-center gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#F3C623]/50 text-xs font-extrabold tracking-[0.14em] text-[#F3C623]">
              {section.badge}
            </span>
            <p class="text-xs font-bold uppercase tracking-[0.24em] text-white/45">{t.labels.trade.productGroups}</p>
          </div>

          <h1 class="mt-5 text-3xl font-semibold tracking-tight text-white sm:text-4xl">{section.title}</h1>
          <p class="mt-4 text-start text-base leading-8 text-white/75">{section.description}</p>
        </div>
      </div>
    </section>

    <!-- What we actually do for this group. -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      {section.products.map((product) => (
        <ProductCard product={product} badge={section.badge} />
      ))}
    </div>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a
        class="pill-link bg-[#F3C623] text-[#10184A] shadow-lg shadow-[#F3C623]/25 transition hover:-translate-y-0.5"
        href={withLanguagePrefix(lang, '/contact')}
      >
        {t.pages.products.cta}
      </a>
      <a
        class="pill-link border border-[#19266A]/15 bg-white text-[#19266A] hover:bg-[#19266A]/5"
        href={withLanguagePrefix(lang, '/logistics')}
      >
        {t.labels.nav.solutions}
      </a>
    </div>

    <!-- Sibling groups: keeps every group page one click from the others, so
         crawl depth stays flat and a buyer who lands on the wrong one recovers. -->
    <section class="mt-14 border-t border-[#19266A]/10 pt-10">
      <h2 class="text-xl font-semibold text-[#19266A]">{t.labels.trade.productGroups}</h2>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {others.map((other) => {
          const otherAccent = groupAccents[other.id] ?? { code: '00', note: other.badge, image: groupFallbackImage };
          return (
            <a
              href={withLanguagePrefix(lang, `/products/${other.id}`)}
              class="card group flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-lg"
            >
              <span class="relative block h-24 overflow-hidden bg-[#19266A]">
                <img
                  src={otherAccent.image}
                  alt=""
                  loading="lazy"
                  class="absolute inset-0 h-full w-full object-cover opacity-80 transition duration-500 group-hover:scale-105"
                  {...imageSize(otherAccent.image)}
                />
                <span class="absolute inset-0 bg-gradient-to-t from-[#10184A]/85 to-transparent"></span>
                <span class="absolute bottom-2 start-3 text-[10px] font-extrabold tracking-[0.18em] text-[#F3C623]">
                  {other.badge}
                </span>
              </span>
              <span class="flex flex-1 flex-col gap-1 p-4">
                <span class="text-sm font-bold text-[#19266A]">{other.title}</span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Layout>
