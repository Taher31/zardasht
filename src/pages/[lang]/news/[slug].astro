---
import Layout from '../../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../../i18n';
import { newsPosts, getNewsPosts, formatNewsDate } from '../../../data/news';
import { imageSize } from '../../../data/image-size';

export function getStaticPaths() {
  return localizedLanguages.flatMap((language) =>
    newsPosts.map((post) => ({
      params: { lang: language.code, slug: post.slug },
      props: { slug: post.slug, lang: language.code },
    })),
  );
}

const { slug, lang: langProp } = Astro.props;
const lang = resolveLang(langProp ?? Astro.params.lang);
const t = getTranslation(lang);

const posts = getNewsPosts(lang);
const post = posts.find((item) => item.slug === slug)!;
const displayDate = formatNewsDate(post.date, lang);

// Everything else, newest first, for the "more news" strip.
const others = posts.filter((item) => item.slug !== slug).slice(0, 3);

const origin = (Astro.site ?? Astro.url).origin;
const postUrl = `${origin}${withLanguagePrefix(lang, `/news/${post.slug}`)}`;
// `date` is a plain YYYY-MM-DD; schema.org and og:article both want ISO-8601.
const publishedIso = new Date(`${post.date}T00:00:00Z`).toISOString();

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': post.kind === 'guide' ? 'Article' : 'NewsArticle',
  headline: post.title,
  description: post.excerpt,
  datePublished: publishedIso,
  dateModified: publishedIso,
  inLanguage: lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  ...(post.image ? { image: [`${origin}${post.image}`] } : {}),
  author: { '@id': `${origin}/#organization` },
  publisher: { '@id': `${origin}/#organization` },
};
---

<Layout
  title={post.title}
  lang={lang}
  translation={t}
  description={post.excerpt}
  image={post.image}
  imageAlt={post.imageAlt || post.title}
  type="article"
  publishedTime={publishedIso}
  breadcrumbs={[
    { name: t.pages.news.title, href: withLanguagePrefix(lang, '/news') },
    { name: post.title, href: withLanguagePrefix(lang, `/news/${post.slug}`) },
  ]}
  schema={[articleSchema]}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <a
      class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A]/70 transition hover:text-[#19266A]"
      href={withLanguagePrefix(lang, '/news')}
    >
      <span aria-hidden="true">←</span>
      {t.pages.news.back}
    </a>

    <p class="section-eyebrow mt-8">{t.pages.news.eyebrow}</p>
    <h1 class="mt-3 text-3xl font-semibold leading-tight tracking-tight text-[#19266A] sm:text-4xl">
      {post.title}
    </h1>
    <time datetime={post.date} class="mt-4 block text-xs font-bold uppercase tracking-[0.18em] text-[#19266A]/50">
      {displayDate}
    </time>

    <div class="card mt-8 overflow-hidden p-0">
      <img
        src={post.image}
        alt={post.imageAlt}
        class="h-auto w-full object-cover"
        loading="eager"
        {...imageSize(post.image)}
      />
    </div>

    <div class="mt-8 space-y-5">
      <p class="text-lg leading-8 text-slate-700">{post.excerpt}</p>
      {post.body.map((paragraph) => (
        <p class="leading-8 text-slate-600">{paragraph}</p>
      ))}
    </div>

    {post.links.length > 0 && (
      <nav class="mt-8 rounded-2xl bg-[#19266A]/5 p-5 ring-1 ring-[#19266A]/10" aria-label={t.pages.news.homeTitle}>
        <ul class="space-y-2">
          {post.links.map((link) => (
            <li>
              <a
                class="inline-flex items-center gap-2 text-sm font-bold text-[#19266A] underline-offset-4 hover:underline"
                href={withLanguagePrefix(lang, link.href)}
              >
                <span aria-hidden="true">↩</span>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <div class="mt-10 flex flex-wrap gap-3 border-t border-slate-200 pt-8">
      <a
        class="pill-link bg-[#F3C623] text-[#10184A] shadow-lg shadow-[#F3C623]/25 transition hover:-translate-y-0.5"
        href={withLanguagePrefix(lang, '/contact')}
      >
        {t.labels.trade.inquiry}
      </a>
      <a
        class="pill-link border border-[#19266A]/15 bg-white text-[#19266A] hover:bg-[#19266A]/5"
        href={withLanguagePrefix(lang, '/news')}
      >
        {t.pages.news.allNews}
      </a>
    </div>
  </article>

  {others.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 pb-16 sm:px-6 sm:pb-20">
      <h2 class="text-xl font-semibold text-[#19266A]">{t.pages.news.homeTitle}</h2>
      <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-3">
        {others.map((item) => (
          <a href={withLanguagePrefix(lang, `/news/${item.slug}`)} class="card group flex flex-col overflow-hidden">
            <div class="relative h-36 overflow-hidden bg-[#19266A]">
              <img
                src={item.image}
                alt=""
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-105"
                {...imageSize(item.image)}
              />
            </div>
            <div class="flex flex-1 flex-col gap-2 p-5">
              <time datetime={item.date} class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#19266A]/50">
                {formatNewsDate(item.date, lang)}
              </time>
              <h3 class="text-base font-semibold leading-snug text-[#19266A]">{item.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
