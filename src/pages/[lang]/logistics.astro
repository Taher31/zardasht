---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';
import { metaDescription } from '../../data/meta-descriptions';
import { imageSize } from '../../data/image-size';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const stats = t.pages.home.stats;
const logisticsGallery = [
  '/images/logestic1.webp',
  '/images/logestic2.webp',
  '/images/logestic3.webp',
  '/images/08_warehouse_logistics.webp',
];
const solutionImages = [
  '/images/logestic1.webp',
  '/images/logestic2.webp',
  '/images/logestic3.webp',
  '/images/06_road_logistics_truck.webp',
];
---

<Layout
  title={t.pages.solutions.title}
  lang={lang}
  translation={t}
  description={metaDescription(lang, 'solutions') ?? t.pages.solutions.intro}
  breadcrumbs={[{ name: t.pages.solutions.title, href: withLanguagePrefix(lang, '/logistics') }]}
>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-dark/80">{t.pages.solutions.eyebrow}</p>
      <h1 class="section-title">{t.pages.solutions.title}</h1>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        {t.pages.solutions.intro}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      {stats.map((stat) => (
        <div class="stat-tile">
          <span class="text-sm font-bold text-brand">{stat.value}</span>
          <span class="text-xs uppercase tracking-[0.18em] text-slate-600">{stat.label}</span>
        </div>
      ))}
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {logisticsGallery.map((image) => (
        <div class="card overflow-hidden p-0">
          <img src={image} alt={t.pages.home.heroImageAlt} class="h-40 w-full object-cover" loading="lazy" {...imageSize(image)} />
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
      {t.pages.solutions.solutions.map((solution, index) => (
        <div class="card space-y-4 overflow-hidden p-0">
          <div class="relative h-44 w-full">
            <img
              src={solutionImages[index] ?? solutionImages[0]}
              alt={solution.title}
              class="h-full w-full object-cover"
              loading="lazy"
              {...imageSize(solutionImages[index] ?? solutionImages[0])}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-dark/70 via-transparent to-transparent"></div>
            <span class="absolute left-4 top-4 rounded-full bg-white/85 px-3 py-1 text-xs font-semibold uppercase tracking-[0.16em] text-brand-dark">LOG</span>
          </div>
          <div class="space-y-4 p-6">
            <div class="flex items-center justify-between">
              <h2 class="text-xl font-semibold text-brand-dark">{solution.title}</h2>
              <span class="badge-chip">{solution.tags[0]}</span>
            </div>
            <p class="text-slate-600">{solution.description}</p>
            <div class="flex flex-wrap gap-2">
              {solution.tags.map((tag) => (
                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <section class="mt-14 rounded-3xl bg-brand-dark px-6 py-10 text-white shadow-2xl shadow-brand-dark/40 sm:px-10">
      <div class="flex flex-col gap-6 text-center lg:flex-row lg:items-center lg:justify-between lg:text-start">
        <div class="space-y-3">
          <p class="text-sm font-semibold uppercase tracking-[0.24em] text-brand-gold/90">{t.pages.solutions.outcomesTitle}</p>
          <h2 class="text-2xl font-semibold text-white sm:text-3xl">{t.pages.solutions.intro}</h2>
          <p class="text-white/75">{t.pages.home.heroSubtitle}</p>
        </div>
        <a class="pill-link w-full bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl lg:w-auto" href={withLanguagePrefix(lang, '/contact')}>
          {t.pages.products.cta}
        </a>
      </div>

      <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
        {t.pages.solutions.outcomes.map((outcome) => (
          <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/15">
            <h3 class="text-lg font-semibold text-white">{outcome.title}</h3>
            <p class="mt-1 text-sm text-white/80">{outcome.description}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</Layout>
