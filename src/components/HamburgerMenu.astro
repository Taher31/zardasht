---
import type { LanguageCode, Translation } from '../i18n';
import { withLanguagePrefix, stripLangFromPath } from '../i18n';
import { createIsActiveChecker } from '../utils/navigation';

interface Link {
  href: string;
  label: string;
}

interface Language {
  code: LanguageCode;
  nativeName: string;
}

interface Props {
  links: Link[];
  languages: Language[];
  lang: LanguageCode;
  currentPath: string;
  homeHref: string;
  translation: Translation;
}

const { links, languages, lang, currentPath, homeHref, translation } = Astro.props;
const pathWithoutLang = stripLangFromPath(currentPath);
const isActive = createIsActiveChecker(currentPath, homeHref);
const isRtl = translation.dir === 'rtl';
const trade = translation.labels.trade;

const secondaryLinks = links.filter((link) => link.href );
const dialogId = `mobile-navigation-${lang}`;
---

<button
  type="button"
  class="mobile-menu-trigger flex h-11 w-11 items-center justify-center rounded-full border border-[#19266A]/10 bg-[#19266A] text-white shadow-sm transition hover:bg-[#10184A] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F3C623] focus-visible:ring-offset-2"
  aria-label={trade.toggleNavigation}
  aria-haspopup="dialog"
  aria-controls={dialogId}
  data-mobile-menu-open
>
  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
  </svg>
</button>

<dialog
  id={dialogId}
  class:list={['mobile-menu-dialog', isRtl && 'mobile-menu-dialog--rtl']}
  data-mobile-menu-dialog
>
  <div class="mobile-menu-shell">
    <header class="mobile-menu-header">
      <a href={homeHref} class="flex min-w-0 items-center gap-3" data-mobile-menu-link>
        <img src="/logo.png" alt="" class="h-11 w-11 shrink-0 object-contain" />
        <div class="min-w-0">
          <p class="truncate text-[10px] font-bold uppercase tracking-[0.2em] text-[#19266A]/45">
            {translation.labels.subbrand}
          </p>
          <p class="truncate text-base font-bold leading-tight text-[#19266A]">
            {translation.labels.brand}
          </p>
        </div>
      </a>

      <button
        type="button"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#19266A]/10 bg-[#19266A]/5 text-[#19266A] transition hover:bg-[#19266A]/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F3C623]"
        aria-label={trade.close}
        data-mobile-menu-close
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </header>

    <div class="mobile-menu-scroll">
      <nav aria-label={trade.menu}>
        <ul class="space-y-2">

          {secondaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                data-mobile-menu-link
                class:list={[
                  'mobile-menu-main-link',
                  isActive(link.href) && 'mobile-menu-main-link--active',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="mt-7 border-t border-slate-200 pt-6" aria-label="Language">
        <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-[#19266A]/40">
          {trade.menu}
        </p>
        <div class="grid grid-cols-2 gap-2">
          {languages.map((language) => (
            <a
              href={withLanguagePrefix(language.code, pathWithoutLang)}
              data-mobile-menu-link
              class:list={[
                'rounded-2xl px-3 py-3 text-center text-sm font-semibold transition',
                lang === language.code
                  ? 'bg-[#F3C623]/20 text-[#19266A] ring-1 ring-[#F3C623]/35'
                  : 'bg-slate-50 text-slate-700 hover:bg-slate-100',
              ]}
            >
              {language.nativeName}
            </a>
          ))}
        </div>
      </section>
    </div>

    <footer class="mobile-menu-footer">
      <a
        href={withLanguagePrefix(lang, '/contact')}
        data-mobile-menu-link
        class="pill-link w-full bg-[#F3C623] py-3.5 text-[#10184A] shadow-lg shadow-[#F3C623]/20 transition hover:bg-[#ffd85f]"
      >
        {trade.inquiry}
      </a>
    </footer>
  </div>
</dialog>

<script>
  const setupMobileMenu = () => {
    const openButton = document.querySelector('[data-mobile-menu-open]');
    const dialog = document.querySelector('[data-mobile-menu-dialog]');

    if (!(openButton instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
    if (openButton.dataset.mobileMenuReady === 'true') return;
    openButton.dataset.mobileMenuReady = 'true';

    const closeButton = dialog.querySelector('[data-mobile-menu-close]');
    const menuLinks = dialog.querySelectorAll('[data-mobile-menu-link]');

    const openMenu = () => {
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      document.documentElement.classList.add('mobile-menu-open');
    };

    const closeMenu = () => {
      if (dialog.open && typeof dialog.close === 'function') {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
      document.documentElement.classList.remove('mobile-menu-open');
      openButton.focus({ preventScroll: true });
    };

    openButton.addEventListener('click', openMenu);
    closeButton?.addEventListener('click', closeMenu);
    menuLinks.forEach((link) => link.addEventListener('click', () => {
      document.documentElement.classList.remove('mobile-menu-open');
      if (dialog.open && typeof dialog.close === 'function') dialog.close();
    }));

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu();
    });

    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('mobile-menu-open');
    });
  };

  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

<style is:global>
  html.mobile-menu-open,
  html.mobile-menu-open body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .mobile-menu-dialog {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #f8fafc;
    color: #0f172a;
    overflow: hidden;
  }

  .mobile-menu-dialog:not([open]) {
    display: none;
  }

  .mobile-menu-dialog[open] {
    display: block;
    animation: mobile-menu-enter 220ms cubic-bezier(.2, .75, .2, 1) both;
  }

  .mobile-menu-dialog::backdrop {
    background: rgba(16, 24, 74, .65);
    backdrop-filter: blur(5px);
  }

  .mobile-menu-shell {
    display: flex;
    width: 100%;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    background:
      radial-gradient(circle at 90% 0%, rgba(243, 198, 35, .13), transparent 28%),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .mobile-menu-header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: max(1rem, env(safe-area-inset-top)) 1rem 1rem;
    border-bottom: 1px solid rgba(25, 38, 106, .10);
    background: rgba(255, 255, 255, .94);
    backdrop-filter: blur(16px);
  }

  .mobile-menu-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    padding: 1.25rem 1rem 2rem;
  }

  .mobile-menu-footer {
    flex: none;
    padding: 1rem 1rem max(1rem, env(safe-area-inset-bottom));
    border-top: 1px solid rgba(25, 38, 106, .10);
    background: rgba(255, 255, 255, .96);
    backdrop-filter: blur(16px);
  }

  .mobile-menu-main-link {
    display: block;
    border-radius: 1rem;
    padding: .9rem 1rem;
    background: #fff;
    color: #19266A;
    font-size: 1rem;
    font-weight: 700;
    box-shadow: inset 0 0 0 1px rgba(25, 38, 106, .07);
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .mobile-menu-main-link:hover {
    background: #f1f5f9;
  }

  .mobile-menu-main-link--active {
    background: #19266A;
    color: #fff;
    box-shadow: none;
  }

  .mobile-menu-dialog--rtl {
    direction: rtl;
  }

  @keyframes mobile-menu-enter {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-dialog[open] { animation: none; }
  }
</style>
