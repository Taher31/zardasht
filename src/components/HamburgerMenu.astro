---
import type { LanguageCode, Translation } from '../i18n';
import { withLanguagePrefix, stripLangFromPath } from '../i18n';
import { createIsActiveChecker } from '../utils/navigation';

interface Link {
  href: string;
  label: string;
}

interface Language {
  code: LanguageCode;
  nativeName: string;
}

interface Props {
  links: Link[];
  languages: Language[];a
  lang: LanguageCode;
  currentPath: string;
  homeHref: string;
  translation: Translation;
}

const { links, languages, lang, currentPath, homeHref, translation } = Astro.props;
const pathWithoutLang = stripLangFromPath(currentPath);
const isActive = createIsActiveChecker(currentPath, homeHref);
const isRtl = translation.dir === 'rtl';
const trade = translation.labels.trade;

const productsHref = withLanguagePrefix(lang, '/products');
const productGroups = [
  { href: withLanguagePrefix(lang, '/products#energy-bitumen'), label: trade.energyBitumen, code: 'EB' },
  { href: withLanguagePrefix(lang, '/products#metals-steel'), label: trade.metalsSteel, code: 'MS' },
  { href: withLanguagePrefix(lang, '/products#agricultural-commodities'), label: trade.agriculturalCommodities, code: 'AG' },
  { href: withLanguagePrefix(lang, '/products#textile-raw-materials'), label: trade.textileRawMaterials, code: 'TX' },
];

const secondaryLinks = links.filter((link) => link.href !== homeHref && link.href !== productsHref);
---

<details class="group relative lg:hidden">
  <summary class:list={[
    'flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full border border-[#19266A]/10 bg-[#19266A] text-white shadow-sm transition hover:bg-[#10184A]',
    isRtl ? 'group-open:fixed group-open:left-4 group-open:top-4 group-open:z-[70]' : 'group-open:fixed group-open:right-4 group-open:top-4 group-open:z-[70]',
    'group-open:border-[#19266A]/10 group-open:bg-white group-open:text-[#19266A]',
  ]}>
    <span class="sr-only">{trade.toggleNavigation}</span>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 transition group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
    </svg>
  </summary>

  <div class="pointer-events-none fixed inset-0 z-[60] opacity-0 transition duration-200 group-open:pointer-events-auto group-open:opacity-100">
    <button
      type="button"
      class="absolute inset-0 h-full w-full bg-[#10184A]/75"
      aria-label={trade.close}
      onclick="this.closest('details')?.removeAttribute('open')"
    ></button>

    <div class:list={[
      'absolute inset-y-0 flex w-[min(92vw,420px)] flex-col overflow-y-auto bg-white px-5 pb-7 pt-6 text-slate-900 shadow-2xl transition duration-200 ease-out',
      isRtl ? 'right-0 translate-x-6 group-open:translate-x-0' : 'left-0 -translate-x-6 group-open:translate-x-0',
    ]}>
      <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-[#19266A]/45">{translation.labels.subbrand}</p>
          <p class="mt-1 text-lg font-semibold text-[#19266A]">{translation.labels.brand}</p>
        </div>
        <button
          type="button"
          class="rounded-full border border-[#19266A]/10 px-3 py-2 text-xs font-bold text-[#19266A] transition hover:bg-[#19266A]/5"
          onclick="this.closest('details')?.removeAttribute('open')"
        >
          {trade.close}
        </button>
      </div>

      <nav class="mt-5" aria-label={trade.menu}>
        <ul class="space-y-2">
          <li>
            <a
              href={homeHref}
              class:list={[
                'block rounded-2xl px-4 py-3 text-base font-semibold transition',
                isActive(homeHref) ? 'bg-[#19266A] text-white' : 'bg-slate-50 text-[#19266A] hover:bg-slate-100',
              ]}
            >
              {translation.labels.nav.home}
            </a>
          </li>

          <li class="rounded-2xl border border-[#19266A]/10 bg-white p-2">
            <a
              href={productsHref}
              class:list={[
                'flex items-center justify-between rounded-xl px-3 py-3 text-base font-semibold transition',
                isActive(productsHref) ? 'bg-[#F3C623]/20 text-[#19266A]' : 'text-[#19266A] hover:bg-slate-50',
              ]}
            >
              <span>{translation.labels.nav.products}</span>
              <span class="text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#19266A]/40">{trade.productGroups}</span>
            </a>
            <div class="mt-1 grid gap-1">
              {productGroups.map((group) => (
                <a href={group.href} class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-[#19266A]/5 hover:text-[#19266A]">
                  <span class="inline-flex h-7 w-7 items-center justify-center rounded-full bg-[#19266A]/5 text-[9px] font-extrabold tracking-[0.1em] text-[#19266A]">{group.code}</span>
                  <span>{group.label}</span>
                </a>
              ))}
            </div>
          </li>

          {secondaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'block rounded-2xl px-4 py-3 text-base font-semibold transition',
                  isActive(link.href) ? 'bg-[#19266A] text-white' : 'bg-slate-50 text-[#19266A] hover:bg-slate-100',
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mt-6 border-t border-slate-100 pt-5">
        <p class="mb-3 text-[10px] font-bold uppercase tracking-[0.2em] text-[#19266A]/40">{trade.menu}</p>
        <div class="grid grid-cols-2 gap-2">
          {languages.map((language) => (
            <a
              href={withLanguagePrefix(language.code, pathWithoutLang)}
              class:list={[
                'rounded-xl px-3 py-2.5 text-center text-sm font-semibold transition',
                lang === language.code ? 'bg-[#F3C623]/20 text-[#19266A]' : 'bg-slate-50 text-slate-700 hover:bg-slate-100',
              ]}
            >
              {language.nativeName}
            </a>
          ))}
        </div>
      </div>

      <div class="mt-auto pt-6">
        <a
          href={withLanguagePrefix(lang, '/contact')}
          class="pill-link w-full bg-[#F3C623] text-[#10184A] shadow-lg shadow-[#F3C623]/20 transition hover:-translate-y-0.5"
        >
          {trade.inquiry}
        </a>
      </div>
    </div>
  </div>
</details>
