---
import type { Translation, LanguageCode } from '../i18n';
import { withLanguagePrefix } from '../i18n';
import { WHATSAPP_URL } from '../config/contact';

interface Props {
  lang: LanguageCode;
  translation: Translation;
}

const { lang, translation } = Astro.props;
const currentYear = new Date().getFullYear();
const whatsappGreetingUrl = `${WHATSAPP_URL}?text=${encodeURIComponent(translation.pages.contact.whatsappGreeting)}`;

const companyLinks = [
  { label: translation.labels.nav.about, href: withLanguagePrefix(lang, '/about') },
  { label: translation.labels.nav.products, href: withLanguagePrefix(lang, '/products') },
  { label: translation.labels.nav.resources, href: withLanguagePrefix(lang, '/trade-map') },
  // { label: translation.labels.nav.solutions, href: withLanguagePrefix(lang, '/logistics') }, // hidden until the logistics page is built out
  { label: translation.labels.nav.quality, href: withLanguagePrefix(lang, '/quality') },
  { label: translation.labels.nav.news, href: withLanguagePrefix(lang, '/news') },
];

const supportLinks = [
  { label: translation.labels.nav.contact, href: withLanguagePrefix(lang, '/contact') },
  { label: translation.labels.footer.tradeMap, href: withLanguagePrefix(lang, '/trade-map') },
  { label: translation.labels.trade.downloadCatalog, href: '/downloads/zardasht-product-catalog.pdf', download: true },
];

const directLinks = [
  { label: 'WhatsApp', href: whatsappGreetingUrl, external: true, copyValue: undefined },
  { label: 'Email', href: `mailto:${translation.pages.contact.email}`, external: false, copyValue: translation.pages.contact.email },
];
---

<footer dir={translation.dir} class:list={["bg-[#10184A] text-white", { 'rtl-footer': translation.dir === 'rtl' }]}>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 lg:py-14">
    <div class="grid grid-cols-2 gap-x-6 gap-y-9 text-start sm:gap-10 md:grid-cols-2 lg:grid-cols-[1.25fr,0.75fr,0.75fr,1fr]">
      <div class="col-span-2 space-y-5 md:col-span-1">
        <div class="flex items-center justify-start gap-3">
          <img src="/logo.webp" alt={translation.labels.brand} class="h-12 w-12 shrink-0 object-contain" width="256" height="256" />
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.24em] text-[#F3C623]">{translation.labels.subbrand}</p>
            <p class="mt-1 text-lg font-semibold leading-tight text-white">{translation.labels.brand}</p>
          </div>
        </div>
        <p class="max-w-md text-sm leading-7 text-white/65">
          {translation.pages.home.heroSubtitle}
        </p>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/40">
          {translation.labels.trade.tagline}
        </p>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.22em] text-[#F3C623]">{translation.labels.footer.company}</h4>
        <ul class="footer-links mt-5 text-sm text-white/65">
          {companyLinks.map((item) => (
            <li><a class="transition hover:text-white" href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-bold uppercase tracking-[0.22em] text-[#F3C623]">{translation.labels.footer.support}</h4>
        <ul class="footer-links mt-5 text-sm text-white/65">
          {supportLinks.map((item) => (
            <li><a class="transition hover:text-white" href={item.href} download={'download' in item ? item.download : undefined}>{item.label}</a></li>
          ))}
        </ul>
        <div class="mt-5 flex flex-wrap gap-2">
          {directLinks.map((item) => (
            <a
              class="rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold text-white/75 transition hover:border-[#F3C623]/40 hover:text-white"
              href={item.href}
              target={item.external ? '_blank' : undefined}
              rel={item.external ? 'noreferrer' : undefined}
              data-copy-email={item.copyValue}
            >
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <div class="col-span-2 space-y-5 md:col-span-1">
        <h4 class="text-xs font-bold uppercase tracking-[0.22em] text-[#F3C623]">{translation.labels.footer.contact}</h4>
        <ul class="space-y-4 text-sm text-white/65">
          <li>
            <span class="block text-[10px] font-bold uppercase tracking-[0.18em] text-white/35">{translation.pages.contact.form.email}</span>
            <a href={`mailto:${translation.pages.contact.email}`} dir="ltr" class="mt-1 inline-block transition hover:text-white" data-copy-email={translation.pages.contact.email}>{translation.pages.contact.email}</a>
          </li>
          <li>
            <span class="block text-[10px] font-bold uppercase tracking-[0.18em] text-white/35">{translation.pages.contact.form.phone}</span>
            <a href={whatsappGreetingUrl} target="_blank" rel="noreferrer" dir="ltr" class="mt-1 inline-block transition hover:text-white">{translation.pages.contact.phone}</a>
          </li>
          <li>
            <span class="block text-[10px] font-bold uppercase tracking-[0.18em] text-white/35">{translation.pages.contact.addressLabel}</span>
            <span class="mt-1 block leading-6">{translation.pages.contact.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-4 border-t border-white/10 pt-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} {translation.labels.footer.copyright}</p>
      <a class="font-semibold text-[#F3C623] transition hover:text-white" href={withLanguagePrefix(lang, '/contact')}>
        {translation.labels.trade.inquiry}
      </a>
    </div>
  </div>
</footer>
