<a
  href="tel:+1234567890"
  class="call-button"
  aria-label="Call us"
>
  ☎
</a>

<style>
  .call-button {
    position: fixed;
    right: 20px;
    bottom: 20px;

    width: 60px;
    height: 60px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #16a34a;
    color: white;
    font-size: 28px;
    text-decoration: none;

    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);

    z-index: 9999;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .call-button:hover {
    transform: scale(1.08);
    background: #15803d;
  }
</style>