---
import type { LanguageCode, Translation } from '../i18n';

interface Props {
  lang: LanguageCode;
  translation: Translation;
}

const { lang, translation } = Astro.props;
const phoneHref = translation.pages.contact.phone.replace(/[^\d+]/g, '');

const ariaLabels: Record<LanguageCode, string> = {
  en: 'Call us',
  fa: 'تماس با ما',
  ar: 'اتصل بنا',
  ru: 'Позвонить нам',
};
---

<a
  href={`tel:${phoneHref}`}
  class="call-button"
  aria-label={ariaLabels[lang] ?? ariaLabels.en}
>
  ☎
</a>

<style>
  .call-button {
    position: fixed;
    right: 20px;
    bottom: 20px;

    width: 60px;
    height: 60px;
    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #16a34a;
    color: white;
    font-size: 28px;
    text-decoration: none;

    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25);

    z-index: 9999;

    transition:
      transform 0.2s ease,
      background 0.2s ease;
  }

  .call-button:hover {
    transform: scale(1.08);
    background: #15803d;
  }
</style>
