---
import type { Translation, LanguageCode } from '../i18n';
import { languages, withLanguagePrefix, stripLangFromPath } from '../i18n';
import { createIsActiveChecker } from '../utils/navigation';

interface Props {
  lang: LanguageCode;
  translation: Translation;
}

const { lang, translation } = Astro.props;
const currentPath = Astro.url.pathname;
const base = withLanguagePrefix(lang, '/');
const productsHref = withLanguagePrefix(lang, '/products');
const marketsHref = withLanguagePrefix(lang, '/trade-map');
const logisticsHref = withLanguagePrefix(lang, '/logistics');
const aboutHref = withLanguagePrefix(lang, '/about');
const contactHref = withLanguagePrefix(lang, '/contact');

const isActive = createIsActiveChecker(currentPath, base);
const isRtl = translation.dir === 'rtl';
const pathWithoutLang = stripLangFromPath(currentPath);
const currentLanguage =
  languages.find((language) => language.code === lang)?.nativeName ?? lang.toUpperCase();

// Strings not covered by the shared i18n nav/trade labels (Header-specific UI chrome).
const chrome = {
  en: {
    menu: 'Menu', close: 'Close menu', open: 'Open menu', language: 'Language',
    energyDescription: 'Bitumen and energy-related trade',
    metalsDescription: 'Iron and steel for regional markets',
    agricultureDescription: 'Barley, grains and pulses',
    textileDescription: 'Silk yarn and textile inputs',
  },
  fa: {
    menu: 'منو', close: 'بستن منو', open: 'باز کردن منو', language: 'زبان',
    energyDescription: 'قیر و کالاهای مرتبط با انرژی',
    metalsDescription: 'آهن و فولاد برای بازارهای منطقه',
    agricultureDescription: 'جو، غلات و حبوبات',
    textileDescription: 'نخ ابریشم و مواد اولیه نساجی',
  },
  ar: {
    menu: 'القائمة', close: 'إغلاق القائمة', open: 'فتح القائمة', language: 'اللغة',
    energyDescription: 'البيتومين والسلع المرتبطة بالطاقة',
    metalsDescription: 'الحديد والصلب للأسواق الإقليمية',
    agricultureDescription: 'الشعير والحبوب والبقوليات',
    textileDescription: 'خيوط الحرير ومدخلات النسيج',
  },
  ru: {
    menu: 'Меню', close: 'Закрыть меню', open: 'Открыть меню', language: 'Язык',
    energyDescription: 'Битум и энергетические товары',
    metalsDescription: 'Железо и сталь для региональных рынков',
    agricultureDescription: 'Ячмень, зерновые и бобовые',
    textileDescription: 'Шелковая пряжа и текстильное сырье',
  },
} as const;

const labels = {
  home: translation.labels.nav.home,
  products: translation.labels.nav.products,
  markets: translation.labels.nav.resources,
  logistics: translation.labels.nav.solutions,
  about: translation.labels.nav.about,
  contact: translation.labels.nav.contact,
  inquiry: translation.labels.trade.inquiry,
  productGroups: translation.labels.trade.productGroups,
  viewAllProducts: translation.labels.trade.viewAllProducts,
  tagline: translation.labels.trade.tagline,
  energy: translation.labels.trade.energyBitumen,
  metals: translation.labels.trade.metalsSteel,
  agriculture: translation.labels.trade.agriculturalCommodities,
  textile: translation.labels.trade.textileRawMaterials,
  ...(chrome[lang] ?? chrome.en),
};

const productGroups = [
  {
    href: `${productsHref}#energy-bitumen`,
    label: labels.energy,
    description: labels.energyDescription,
    code: 'EB',
  },
  {
    href: `${productsHref}#metals-steel`,
    label: labels.metals,
    description: labels.metalsDescription,
    code: 'MS',
  },
  {
    href: `${productsHref}#agricultural-commodities`,
    label: labels.agriculture,
    description: labels.agricultureDescription,
    code: 'AG',
  },
  {
    href: `${productsHref}#textile-raw-materials`,
    label: labels.textile,
    description: labels.textileDescription,
    code: 'TX',
  },
];

const mainLinks = [
  { href: base, label: labels.home },
  { href: marketsHref, label: labels.markets },
  { href: logisticsHref, label: labels.logistics },
  { href: aboutHref, label: labels.about },
  { href: contactHref, label: labels.contact },
];

const desktopLinkClass = (href: string) =>
  `site-nav-link ${isActive(href) ? 'site-nav-link--active' : ''}`;

const dialogId = `site-mobile-menu-${lang}`;
---

<header class="site-header sticky top-0 z-50 border-b border-[#19266A]/10 bg-white/95 text-slate-900 shadow-[0_12px_32px_-28px_rgba(16,24,74,.65)] backdrop-blur-xl">
  <!-- Utility strip: visually separate from navigation -->
  <div class="border-b border-white/10 bg-[#10184A] text-white">
    <div class="mx-auto flex min-h-9 w-full max-w-7xl items-center justify-between gap-4 px-4 py-2 sm:px-6 lg:px-8">
      <p class="truncate text-[10px] font-bold uppercase tracking-[0.18em] text-white/70 sm:text-[11px]">
        {labels.tagline}
      </p>

      <div class="hidden items-center gap-4 md:flex">
        <a
          href={`mailto:${translation.pages.contact.email}`}
          class="text-[11px] font-semibold text-white/65 transition hover:text-white"
        >
          {translation.pages.contact.email}
        </a>
        <span class="h-3 w-px bg-white/20"></span>
        <a
          href={contactHref}
          class="text-[11px] font-extrabold uppercase tracking-[0.12em] text-[#F3C623] transition hover:text-white"
        >
          {labels.inquiry}
        </a>
      </div>
    </div>
  </div>

  <!-- Main navigation -->
  <div class="mx-auto flex min-h-[78px] w-full max-w-7xl items-center gap-5 px-4 sm:px-6 lg:px-8">
    <a href={base} class="flex min-w-0 shrink-0 items-center gap-3" aria-label={translation.labels.brand}>
      <img
        src="/logo.png"
        alt={translation.labels.brand}
        class="h-12 w-12 shrink-0 object-contain"
      />
      <div class="hidden min-w-0 sm:block">
        <p class="max-w-[250px] truncate text-[9px] font-extrabold uppercase tracking-[0.2em] text-[#19266A]/45">
          {labels.tagline}
        </p>
        <p class="max-w-[260px] truncate text-base font-extrabold leading-tight text-[#19266A]">
          {translation.labels.brand}
        </p>
      </div>
    </a>

    <!-- Desktop: each concern gets its own visual zone -->
    <nav class="hidden min-w-0 flex-1 items-center justify-end xl:flex" aria-label="Primary navigation">
      <div class="flex items-center rounded-2xl border border-[#19266A]/8 bg-slate-50/80 p-1.5">
        <a href={base} class={desktopLinkClass(base)}>{labels.home}</a>

        <!-- Products is deliberately different from ordinary nav links -->
        <details class="products-menu group relative">
          <summary class:list={[
            'site-nav-link site-nav-products flex cursor-pointer list-none items-center gap-2',
            isActive(productsHref) && 'site-nav-link--active',
          ]}>
            <span>{labels.products}</span>
            <svg class="h-3.5 w-3.5 transition duration-200 group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>

          <div class:list={[
            'absolute top-full z-[80] mt-3 w-[420px] overflow-hidden rounded-3xl border border-[#19266A]/10 bg-white shadow-[0_28px_80px_-28px_rgba(16,24,74,.45)]',
            isRtl ? 'right-0' : 'left-0',
          ]}>
            <div class="border-b border-slate-100 bg-slate-50/70 px-5 py-4">
              <div class="flex items-center justify-between gap-4">
                <div>
                  <p class="text-[10px] font-extrabold uppercase tracking-[0.18em] text-[#19266A]/40">
                    {labels.productGroups}
                  </p>
                  <p class="mt-1 text-sm font-bold text-[#19266A]">{labels.products}</p>
                </div>
                <a href={productsHref} class="text-xs font-extrabold text-[#19266A] transition hover:text-[#DDAE13]">
                  {labels.viewAllProducts}
                </a>
              </div>
            </div>

            <div class="grid gap-1 p-2">
              {productGroups.map((group) => (
                <a
                  href={group.href}
                  class="group/item flex items-start gap-3 rounded-2xl px-3 py-3 transition hover:bg-[#19266A]/5"
                >
                  <span class="mt-0.5 inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#19266A] text-[9px] font-black tracking-[0.1em] text-white shadow-sm transition group-hover/item:bg-[#F3C623] group-hover/item:text-[#10184A]">
                    {group.code}
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-sm font-extrabold text-[#19266A]">{group.label}</span>
                    <span class="mt-0.5 block text-xs leading-5 text-slate-500">{group.description}</span>
                  </span>
                  <svg class="mt-2 h-4 w-4 shrink-0 text-[#19266A]/25 transition group-hover/item:translate-x-0.5 group-hover/item:text-[#19266A] rtl:group-hover/item:-translate-x-0.5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                    <path d="M7 4.5 12.5 10 7 15.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </details>

        {mainLinks.slice(1).map((link) => (
          <a href={link.href} class={desktopLinkClass(link.href)}>{link.label}</a>
        ))}
      </div>

      <!-- Strong separator before actions -->
      <div class="mx-3 h-8 w-px shrink-0 bg-[#19266A]/10"></div>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href={contactHref}
          class="inline-flex min-h-11 items-center justify-center rounded-xl bg-[#F3C623] px-5 text-xs font-black text-[#10184A] shadow-[0_8px_20px_-12px_rgba(243,198,35,.9)] transition hover:-translate-y-0.5 hover:bg-[#ffd85f]"
        >
          {labels.inquiry}
        </a>

        <details class="language-menu group relative">
          <summary class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-xl border border-[#19266A]/10 bg-white px-3 text-xs font-extrabold text-[#19266A] transition hover:bg-slate-50">
            <span>{currentLanguage}</span>
            <svg class="h-3.5 w-3.5 transition group-open:rotate-180" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <div class:list={[
            'absolute top-full z-[90] mt-3 w-52 rounded-2xl border border-[#19266A]/10 bg-white p-2 shadow-[0_24px_60px_-24px_rgba(16,24,74,.5)]',
            isRtl ? 'left-0' : 'right-0',
          ]}>
            <p class="px-3 pb-2 pt-1 text-[9px] font-black uppercase tracking-[0.18em] text-[#19266A]/35">
              {labels.language}
            </p>
            {languages.map((language) => (
              <a
                href={withLanguagePrefix(language.code as LanguageCode, pathWithoutLang)}
                class:list={[
                  'block rounded-xl px-3 py-2.5 text-sm font-bold transition',
                  lang === language.code
                    ? 'bg-[#F3C623]/18 text-[#19266A]'
                    : 'text-slate-600 hover:bg-slate-50 hover:text-[#19266A]',
                ]}
              >
                {language.nativeName}
              </a>
            ))}
          </div>
        </details>
      </div>
    </nav>

    <!-- Mobile trigger -->
    <button
      type="button"
      class="ms-auto flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#19266A] text-white shadow-sm transition hover:bg-[#10184A] focus:outline-none focus-visible:ring-2 focus-visible:ring-[#F3C623] focus-visible:ring-offset-2 xl:hidden"
      aria-label={labels.open}
      aria-haspopup="dialog"
      aria-controls={dialogId}
      data-site-menu-open
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </div>
</header>

<!-- Fullscreen mobile navigation lives outside header's visual flow -->
<dialog
  id={dialogId}
  class:list={['site-menu-dialog', isRtl && 'site-menu-dialog--rtl']}
  data-site-menu-dialog
>
  <div class="site-menu-panel">
    <div class="site-menu-mobile-header">
      <a href={base} class="flex min-w-0 items-center gap-3" data-site-menu-link>
        <img src="/logo.png" alt="" class="h-11 w-11 shrink-0 object-contain" />
        <div class="min-w-0">
          <p class="truncate text-[9px] font-black uppercase tracking-[0.18em] text-[#19266A]/40">{labels.tagline}</p>
          <p class="truncate text-sm font-extrabold text-[#19266A] sm:text-base">{translation.labels.brand}</p>
        </div>
      </a>

      <button
        type="button"
        class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#19266A]/5 text-[#19266A] transition hover:bg-[#19266A]/10"
        aria-label={labels.close}
        data-site-menu-close
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="site-menu-mobile-scroll">
      <!-- Primary pages -->
      <section>
        <p class="site-menu-section-label">{labels.menu}</p>
        <div class="mt-3 grid gap-2">
          <a
            href={base}
            data-site-menu-link
            class:list={['mobile-primary-link', isActive(base) && 'mobile-primary-link--active']}
          >
            <span>{labels.home}</span>
            <span class="mobile-primary-index">01</span>
          </a>

          <a
            href={marketsHref}
            data-site-menu-link
            class:list={['mobile-primary-link', isActive(marketsHref) && 'mobile-primary-link--active']}
          >
            <span>{labels.markets}</span>
            <span class="mobile-primary-index">02</span>
          </a>

          <a
            href={logisticsHref}
            data-site-menu-link
            class:list={['mobile-primary-link', isActive(logisticsHref) && 'mobile-primary-link--active']}
          >
            <span>{labels.logistics}</span>
            <span class="mobile-primary-index">03</span>
          </a>

          <a
            href={aboutHref}
            data-site-menu-link
            class:list={['mobile-primary-link', isActive(aboutHref) && 'mobile-primary-link--active']}
          >
            <span>{labels.about}</span>
            <span class="mobile-primary-index">04</span>
          </a>

          <a
            href={contactHref}
            data-site-menu-link
            class:list={['mobile-primary-link', isActive(contactHref) && 'mobile-primary-link--active']}
          >
            <span>{labels.contact}</span>
            <span class="mobile-primary-index">05</span>
          </a>
        </div>
      </section>

      <!-- Product groups are visually their own section -->
      <section class="mt-7 rounded-3xl border border-[#19266A]/10 bg-white p-3 shadow-sm">
        <div class="flex items-center justify-between gap-4 px-2 py-2">
          <div>
            <p class="site-menu-section-label">{labels.productGroups}</p>
            <a href={productsHref} data-site-menu-link class="mt-1 block text-base font-black text-[#19266A]">
              {labels.products}
            </a>
          </div>
          <span class="rounded-lg bg-[#F3C623]/20 px-2 py-1 text-[10px] font-black tracking-[0.12em] text-[#19266A]">04</span>
        </div>

        <div class="mt-2 grid gap-1">
          {productGroups.map((group) => (
            <a href={group.href} data-site-menu-link class="mobile-product-link">
              <span class="mobile-product-code">{group.code}</span>
              <span class="min-w-0 flex-1">
                <span class="block text-sm font-extrabold text-[#19266A]">{group.label}</span>
                <span class="mt-0.5 block text-xs leading-5 text-slate-500">{group.description}</span>
              </span>
            </a>
          ))}
        </div>
      </section>

      <!-- Language is another distinct section -->
      <section class="mt-7 border-t border-slate-200 pt-6">
        <p class="site-menu-section-label">{labels.language}</p>
        <div class="mt-3 grid grid-cols-2 gap-2">
          {languages.map((language) => (
            <a
              href={withLanguagePrefix(language.code as LanguageCode, pathWithoutLang)}
              data-site-menu-link
              class:list={[
                'rounded-xl px-3 py-3 text-center text-sm font-bold transition',
                lang === language.code
                  ? 'bg-[#19266A] text-white'
                  : 'border border-[#19266A]/8 bg-white text-slate-600 hover:bg-slate-50 hover:text-[#19266A]',
              ]}
            >
              {language.nativeName}
            </a>
          ))}
        </div>
      </section>
    </div>

    <div class="site-menu-mobile-footer">
      <a
        href={contactHref}
        data-site-menu-link
        class="flex min-h-12 w-full items-center justify-center rounded-xl bg-[#F3C623] px-5 text-sm font-black text-[#10184A] shadow-[0_10px_30px_-18px_rgba(243,198,35,.9)]"
      >
        {labels.inquiry}
      </a>
    </div>
  </div>
</dialog>

<script>
  const setupSiteMenu = () => {
    const openButton = document.querySelector('[data-site-menu-open]');
    const dialog = document.querySelector('[data-site-menu-dialog]');

    if (!(openButton instanceof HTMLButtonElement)) return;
    if (!(dialog instanceof HTMLDialogElement)) return;
    if (openButton.dataset.ready === 'true') return;

    openButton.dataset.ready = 'true';

    const closeButton = dialog.querySelector('[data-site-menu-close]');
    const links = dialog.querySelectorAll('[data-site-menu-link]');

    const lockPage = () => {
      document.documentElement.classList.add('site-menu-is-open');
    };

    const unlockPage = () => {
      document.documentElement.classList.remove('site-menu-is-open');
    };

    const openMenu = () => {
      if (!dialog.open) dialog.showModal();
      lockPage();
    };

    const closeMenu = () => {
      if (dialog.open) dialog.close();
      unlockPage();
    };

    openButton.addEventListener('click', openMenu);
    closeButton?.addEventListener('click', closeMenu);

    links.forEach((link) => {
      link.addEventListener('click', () => {
        unlockPage();
        if (dialog.open) dialog.close();
      });
    });

    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeMenu();
    });

    dialog.addEventListener('close', unlockPage);
  };

  setupSiteMenu();
  document.addEventListener('astro:page-load', setupSiteMenu);
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  html.site-menu-is-open,
  html.site-menu-is-open body {
    overflow: hidden;
    overscroll-behavior: none;
  }

  .site-nav-link {
    position: relative;
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    border-radius: 12px;
    padding: 0 13px;
    color: #475569;
    font-size: 13px;
    font-weight: 750;
    white-space: nowrap;
    transition: background 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }

  .site-nav-link:hover {
    background: #fff;
    color: #19266A;
    box-shadow: 0 3px 12px -9px rgba(16, 24, 74, .55);
  }

  .site-nav-link--active {
    background: #fff;
    color: #19266A;
    box-shadow: 0 4px 14px -10px rgba(16, 24, 74, .65);
  }

  .site-nav-link--active::after {
    position: absolute;
    right: 13px;
    bottom: 5px;
    left: 13px;
    height: 2px;
    border-radius: 999px;
    background: #F3C623;
    content: '';
  }

  .site-nav-products {
    color: #19266A;
    font-weight: 850;
  }

  .site-menu-dialog {
    position: fixed;
    inset: 0;
    z-index: 9999;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #f8fafc;
    color: #0f172a;
    overflow: hidden;
  }

  .site-menu-dialog:not([open]) {
    display: none;
  }

  .site-menu-dialog[open] {
    display: block;
    animation: site-menu-enter 180ms cubic-bezier(.2, .75, .2, 1) both;
  }

  .site-menu-dialog::backdrop {
    background: rgba(16, 24, 74, .65);
  }

  .site-menu-panel {
    display: flex;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    background:
      radial-gradient(circle at 90% 0%, rgba(243, 198, 35, .12), transparent 25%),
      linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
  }

  .site-menu-mobile-header {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: max(14px, env(safe-area-inset-top)) 16px 14px;
    border-bottom: 1px solid rgba(25, 38, 106, .09);
    background: rgba(255, 255, 255, .96);
  }

  .site-menu-mobile-scroll {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 22px 16px 32px;
    -webkit-overflow-scrolling: touch;
  }

  .site-menu-mobile-footer {
    flex: none;
    padding: 12px 16px max(14px, env(safe-area-inset-bottom));
    border-top: 1px solid rgba(25, 38, 106, .09);
    background: rgba(255, 255, 255, .98);
  }

  .site-menu-section-label {
    color: rgba(25, 38, 106, .42);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .mobile-primary-link {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    border: 1px solid rgba(25, 38, 106, .07);
    border-radius: 16px;
    background: #fff;
    padding: 0 16px;
    color: #19266A;
    font-size: 15px;
    font-weight: 850;
    box-shadow: 0 6px 16px -15px rgba(16, 24, 74, .5);
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .mobile-primary-link:hover {
    background: #f8fafc;
  }

  .mobile-primary-link--active {
    border-color: #19266A;
    background: #19266A;
    color: #fff;
  }

  .mobile-primary-index {
    color: currentColor;
    font-size: 9px;
    font-weight: 900;
    letter-spacing: .12em;
    opacity: .35;
  }

  .mobile-product-link {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    border-radius: 16px;
    padding: 12px;
    transition: background 160ms ease;
  }

  .mobile-product-link:hover {
    background: rgba(25, 38, 106, .045);
  }

  .mobile-product-code {
    display: inline-flex;
    width: 36px;
    height: 36px;
    flex: none;
