---
import Layout from '../../layouts/Layout.astro';
import { getTranslation, resolveLang, withLanguagePrefix, localizedLanguages } from '../../i18n';

export function getStaticPaths() {
  return localizedLanguages.map((language) => ({ params: { lang: language.code } }));
}

const lang = resolveLang(Astro.props.lang ?? Astro.params.lang);
const t = getTranslation(lang);
const qualityGallery = [
  '/images/03_metals_steel.webp',
  '/images/02_bitumen.webp',
  '/images/08_warehouse_logistics.webp',
  '/images/05_textile_yarn.webp',
];
---

<Layout title={t.pages.quality.title} lang={lang} translation={t}>
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">
    <div class="text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-dark/80">{t.pages.quality.eyebrow}</p>
      <h1 class="section-title">{t.pages.quality.title}</h1>
      <p class="mt-3 text-base text-slate-600 sm:text-lg">
        {t.pages.quality.intro}
      </p>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {qualityGallery.map((image) => (
        <div class="card overflow-hidden p-0">
          <img src={image} alt={t.pages.home.heroImageAlt} class="h-40 w-full object-cover" loading="lazy" />
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-3">
      {t.pages.quality.pillars.map((pillar) => (
        <div class="card space-y-3 p-6">
          <span class="badge-chip">{pillar.badge}</span>
          <h2 class="text-xl font-semibold text-brand-dark">{pillar.title}</h2>
          <p class="text-slate-600">{pillar.description}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 rounded-3xl bg-brand-dark px-6 py-10 text-white shadow-2xl shadow-brand-dark/40 sm:px-10">
      <div class="text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-brand-gold/90">{t.pages.quality.processTitle}</p>
      </div>
      <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-4">
        {t.pages.quality.process.map((step) => (
          <div class="rounded-2xl bg-white/10 p-4 ring-1 ring-white/15">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-brand-gold/90">{step.title}</p>
            <p class="mt-2 text-sm text-white/80">{step.description}</p>
          </div>
        ))}
      </div>
      <div class="mt-8 flex justify-center">
        <a
          class="pill-link bg-brand-gold text-brand-dark shadow-lg shadow-brand-gold/40 transition hover:-translate-y-0.5 hover:shadow-xl"
          href={withLanguagePrefix(lang, '/contact')}
        >
          {t.labels.trade.inquiry}
        </a>
      </div>
    </div>
  </div>
</Layout>
